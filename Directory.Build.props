<Project>
  <!--
    NuGet lock files (packages.lock.json next to every project): restore resolves exactly the
    recorded package graph, and in CI (GitHub Actions sets CI=true) the restore fails instead
    of silently updating the lock when a csproj and its lock file disagree - so a moved or
    re-published package version can never change what gets built (OpenSSF Scorecard
    Pinned-Dependencies). Dependabot updates the lock files together with the csproj versions.
    Locally, a plain `dotnet restore` refreshes the locks after a package change.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'StudyLife.Client'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!--
    The Blazor WebAssembly client is the one project without a lock file: the WebAssembly SDK
    adds implicit package references (Microsoft.NET.Sdk.WebAssembly.Pack, ILLink.Tasks, the
    Internal.Assets pack) whose versions follow the installed SDK patch, so a lock written by
    one SDK fails locked-mode restore on the next patch. Its own package references are pinned
    to exact versions in the csproj and it ships no server-side code.
  -->
  <!--
    The server is published for linux-x64 and linux-arm64 (ci-cd.yml, publish-server). A
    `dotnet publish -r <rid>` restores the server AND the libraries it references with that
    runtime, so the same RID set is declared on all of them: a plain restore then records the
    same runtime graph in the lock files that the publish restore expects (NU1004 otherwise).
    The Blazor client keeps its own browser-wasm runtime, tests are never published.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StudyLife.Server' or '$(MSBuildProjectName)' == 'StudyLife.Shared' or '$(MSBuildProjectName)' == 'StudyLife.Stt' or '$(MSBuildProjectName)' == 'StudyLife.Tts'">
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>

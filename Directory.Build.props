<Project>
  <!--
    NuGet lock files (packages.lock.json next to every project): restore resolves exactly the
    recorded package graph, and in CI (GitHub Actions sets CI=true) the restore fails instead
    of silently updating the lock when a csproj and its lock file disagree - so a moved or
    re-published package version can never change what gets built (OpenSSF Scorecard
    Pinned-Dependencies). Dependabot updates the lock files together with the csproj versions.
    Locally, a plain `dotnet restore` refreshes the locks after a package change.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StudyLife.Server' or $(MSBuildProjectName.EndsWith('.Tests'))">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!--
    Locked: the server (the published artifact) and the test projects. The server's lock
    records the whole transitive graph, including every package the Shared/Stt/Tts libraries
    bring in, so those three stay unlocked on purpose: a library with its own lock has to
    declare the server's publish runtimes (a `dotnet publish -r <rid>` restores the referenced
    libraries with that runtime, NU1004 otherwise), and a library that declares
    RuntimeIdentifiers becomes runtime-specific for every consumer - studylife-app builds
    StudyLife.Shared for android-arm64/x64 from a checkout of this repo and failed with
    NETSDK1047 when Shared carried linux-only runtimes. The Blazor WebAssembly client stays
    unlocked as well: its implicit WebAssembly SDK packages follow the installed SDK patch.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StudyLife.Server'">
    <!-- The two publish targets of ci-cd.yml, so that a plain restore and the publish
         restore agree on the server's runtime graph and its lock stays valid for both. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!--
    Warnings are errors, repo-wide: the build is warning-free today (2026-09-12 CI audit) and
    this keeps it that way - a new warning fails the PR instead of accumulating. Same setting
    as the other .NET repos; analyzer levels stay at the SDK defaults.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>

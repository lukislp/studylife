<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deterministic wrapper around the Toolbelt.Blazor.I18nText source generator
    (docs/REPRODUCIBLE-BUILDS.md). The package's own generator adds the typed text classes to the
    compilation in thread-completion order, which made StudyLife.Client.dll/.pdb differ between
    two clean builds. This generator runs the same package code (I18nTextCompiler) and only adds
    the results in a fixed, ordinal order. StudyLife.Client.csproj swaps the package's analyzer
    for this one.

    Analyzer assemblies must target netstandard2.0. The package's generator and its two
    dependencies are copied next to this assembly: the compiler loads an analyzer's dependencies
    from the analyzer's own directory.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- RS2008 asks for release tracking files for the diagnostic IDs a published analyzer
         ships. This one is never published; it only runs inside this repository's build. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the compiler that loads the generator brings its own Roslyn. 4.8 is
         older than every compiler in a .NET 10 SDK, so it loads in all of them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <!-- Only for its files: the generator assembly is referenced directly below, and the
         package's own analyzer must not run inside this project. -->
    <PackageReference Include="Toolbelt.Blazor.I18nText.SourceGenerator" Version="14.1.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Toolbelt.Blazor.I18nText.SourceGenerator" HintPath="$(PkgToolbelt_Blazor_I18nText_SourceGenerator)\analyzers\dotnet\cs\Toolbelt.Blazor.I18nText.SourceGenerator.dll" Private="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(PkgToolbelt_Blazor_I18nText_SourceGenerator)\analyzers\dotnet\cs\Newtonsoft.Json.dll" Private="true" />
    <Reference Include="TinyCsvParser" HintPath="$(PkgToolbelt_Blazor_I18nText_SourceGenerator)\analyzers\dotnet\cs\TinyCsvParser.dll" Private="true" />
  </ItemGroup>
</Project>

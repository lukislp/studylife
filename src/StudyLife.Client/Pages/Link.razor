@page "/link"
@layout PublicLayout
@using System.Text
@using System.Text.Json.Nodes
@using StudyLife.Shared
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject INativeAppAuth NativeAuth
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Links this NEW, not-yet-logged-in device to an existing account via a code
   (register/begin-linked) - an alternative to the browser-dependent WebAuthn cross-device/
   hybrid transport (QR+Bluetooth), which depending on browser/OS is either unavailable or only
   discoverable behind a hidden "more options" link. PasskeyDeviceManager generates the code on
   a device that's already logged in. This device registers its OWN, local passkey (no
   cross-device ceremony) - it then ends up PENDING until the other device approves it via the
   device list; no token is issued here, hence no forceLoad redirect. *@

<PageTitle>@T.LinkPageTitle</PageTitle>

<div class="progress-share-page">
    <div class="progress-share-card">
        <h1>@T.LinkHeading</h1>
        <p class="ss-desc">@T.LinkIntro</p>
        @if (_success)
        {
            <p class="ss-desc" style="margin-top:1.25rem;">✅ @T.LinkSuccess</p>
            <a href="@("/login" + _app.LinkQuery)" class="btn-secondary" style="text-align:center; margin-top:0.75rem;">@T.PasskeysGoToLogin</a>
        }
        else
        {
            @if (_error != null)
            {
                <p class="ss-desc" style="color:var(--danger, #e74c3c)">@_error</p>
            }
            <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1.25rem;">
                <label class="ss-label" for="link-code">@T.LinkCodeLabel</label>
                <input id="link-code" class="input" type="text" maxlength="20" autocapitalize="characters"
                       placeholder="XXXX-XXXX" @bind="_code" @bind:event="oninput" />
                <button type="button" class="btn-primary" @onclick="ConnectAsync"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_code))">
                    @(_busy ? T.LoginWorking : T.LinkConnectButton)
                </button>
                <a href="@("/login" + _app.LinkQuery)" class="btn-secondary" style="text-align:center;">@T.GoToLoginLink</a>
            </div>
        }
    </div>
</div>

@code {
    private I18nText.AuthText T = new();
    private string _code = "";
    private bool _busy;
    private bool _success;
    private string? _error;
    private IJSObjectReference? _module;

    // App return path (?app=1) as in Login.razor: the page runs in the native app's system
    // browser, the link code arrives pre-filled via fragment. There's no token here -
    // completion is signalled to the app only via a linked=1 redirect (details in AppReturnContext).
    private AppReturnContext _app = AppReturnContext.FromUri(new Uri("https://unused.invalid/"));

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _app = AppReturnContext.FromUri(uri);
        if (_app.IsActive && uri.Fragment is { Length: > 1 } fragment)
        {
            foreach (var pair in fragment.TrimStart('#').Split('&'))
            {
                var kv = pair.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "code") _code = Uri.UnescapeDataString(kv[1]);
            }
        }
        T = await I18nText.GetTextTableAsync<I18nText.AuthText>(this);
    }

    private async Task ConnectAsync()
    {
        var code = _code.Trim();
        if (code.Length == 0) return;

        // Native app shell without in-app passkeys (free signing): passkey creation via the
        // system browser. With in-app passkeys the normal flow below runs, only the
        // WebAuthn call goes to the native dialog. Always false on the web.
        if (NativeAuth.IsAvailable && !NativeAuth.SupportsInAppPasskeys)
        {
            await NativeConnectAsync(code);
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (!NativeAuth.SupportsInAppPasskeys)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Login.razor.js");
                if (!await _module.InvokeAsync<bool>("isPasskeySupported"))
                {
                    _error = T.NotSupported;
                    return;
                }
            }

            var begin = await Http.PostAsJsonAsync("api/auth/register/begin-linked",
                new DeviceLinkRedeemRequestDto { Code = code });
            if (!begin.IsSuccessStatusCode) { _error = T.LinkInvalidCode; return; }
            var options = await begin.Content.ReadFromJsonAsync<PasskeyBeginResponseDto>();
            if (options == null) { _error = T.LinkInvalidCode; return; }

            var attestationJson = NativeAuth.SupportsInAppPasskeys
                ? await NativeAuth.CreatePasskeyAsync(options.OptionsJson)
                : await _module!.InvokeAsync<string>("createPasskey", options.OptionsJson);
            if (attestationJson == null) { _error = T.LinkConnectFailed; return; } // native dialog cancelled
            var body = new JsonObject
            {
                ["optionsId"] = options.OptionsId,
                ["response"] = JsonNode.Parse(attestationJson),
            };
            var complete = await Http.PostAsync("api/auth/register/complete",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            if (!complete.IsSuccessStatusCode) { _error = T.LinkInvalidCode; return; }

            // No token in the response (Pending=true always on this path) - this device
            // deliberately stays logged out until the approving device has consented.
            if (_app.IsActive)
            {
                // Signal completion to the native app (closes the browser sheet).
                Nav.NavigateTo(_app.BuildReturnRedirect("linked=1"), forceLoad: true);
                return;
            }
            _success = true;
        }
        catch (JSException)
        {
            // User cancelled the passkey dialog, or the authenticator rejected it.
            _error = T.LinkConnectFailed;
        }
        catch (HttpRequestException)
        {
            _error = T.LinkConnectFailed;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NativeConnectAsync(string code)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await NativeAuth.AuthenticateAsync($"link#code={Uri.EscapeDataString(code)}");
            // Empty string = "linked without a token" (see INativeAppAuth) - this device stays
            // logged out just like in the web flow, until the other device approves it.
            if (result == "")
            {
                _success = true;
                return;
            }
            _error = T.LinkConnectFailed;
        }
        finally
        {
            _busy = false;
        }
    }
}

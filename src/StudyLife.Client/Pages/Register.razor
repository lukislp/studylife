@page "/register"
@layout PublicLayout
@using System.Text
@using System.Text.Json.Nodes
@using StudyLife.Shared
@inherits LocalizedComponentBase<I18nText.AuthText>
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SessionTokenStore TokenStore
@inject INativeAppAuth NativeAuth
@inject IServiceProvider Services

@* Passkey registration (phase 2), same layout/style pattern as Login.razor. The very first
   registration "claims" the existing phase-1 user server-side, including all existing data
   (AuthController.RegisterComplete); every subsequent one creates a new, empty account - here
   on the client both are the same flow. Imports the login page's collocated JS module
   (./Pages/Login.razor.js) instead of duplicating the WebAuthn conversion. *@

@if (IsTextLoaded)
{
<PageTitle>@T.RegisterPageTitle</PageTitle>

<div class="progress-share-page">
    <div class="progress-share-card">
        <h1>@T.RegisterHeading</h1>
        @if (!_usePassword)
        {
            <p class="ss-desc">@T.RegisterIntro</p>
        }
        @if (_error != null)
        {
            <p class="ss-desc" role="alert" style="color:var(--danger, #e74c3c)">@_error</p>
        }
        <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1.25rem;">
            @if (_passwordOffered && P is not null)
            {
                @* Passkey or username + password (owner decision 2026-11-14). The passkey stays the
                   first and recommended choice; both create the same kind of account. *@
                <fieldset style="border:none; margin:0; padding:0; display:flex; flex-direction:column; gap:0.5rem;">
                    <legend class="ss-label" style="margin-bottom:0.5rem;">@P.RegisterMethodLegend</legend>
                    <label class="toggle-row" style="gap:0.5rem; align-items:flex-start;">
                        <input type="radio" name="register-method" checked="@(!_usePassword)" @onchange="() => _usePassword = false" />
                        <span><strong>@P.RegisterMethodPasskey</strong><br /><span class="ss-desc">@P.RegisterMethodPasskeyHint</span></span>
                    </label>
                    <label class="toggle-row" style="gap:0.5rem; align-items:flex-start;">
                        <input type="radio" name="register-method" checked="@_usePassword" @onchange="() => _usePassword = true" />
                        <span><strong>@P.RegisterMethodPassword</strong><br /><span class="ss-desc">@P.RegisterMethodPasswordHint</span></span>
                    </label>
                </fieldset>
            }
            <label class="ss-label" for="register-name">@T.DisplayNameLabel</label>
            <input id="register-name" class="input" type="text" maxlength="100" @ref="_nameInput"
                   aria-invalid="@AriaInvalid(RegistrationField.DisplayName)"
                   placeholder="@T.DisplayNamePlaceholder" @bind="_displayName" @bind:event="oninput" />
            @if (string.IsNullOrEmpty(_inviteToken))
            {
                @* A setup code only exists for the very first registration of an unclaimed installation;
                   whoever follows an invite link never needs it (and the page must not reveal whether the
                   installation is claimed, so there is no lookup - the invite alone decides). *@
                <label class="ss-label" for="register-setup-secret">@T.SetupSecretLabel</label>
                <input id="register-setup-secret" class="input" type="text" maxlength="20"
                       placeholder="@T.SetupSecretPlaceholder" @bind="_setupSecret" @bind:event="oninput" />
                <p class="ss-desc" style="font-size:0.8rem; margin-top:-0.5rem;">@T.SetupSecretHint</p>
            }
            @if (_usePassword && P is not null)
            {
                <form @onsubmit="RegisterWithPasswordAsync" style="display:flex; flex-direction:column; gap:0.5rem;">
                    <label class="ss-label" for="register-username">@P.UsernameLabel</label>
                    <input id="register-username" name="username" class="input" type="text" autocomplete="username"
                           autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="64"
                           aria-describedby="register-username-hint" @ref="_usernameInput"
                           aria-invalid="@AriaInvalid(RegistrationField.Username)" @bind="_username" @bind:event="oninput" />
                    <p class="ss-desc" id="register-username-hint" style="font-size:0.8rem; margin-top:0">@P.UsernameHint</p>
                    <label class="ss-label" for="register-password">@P.PasswordLabel</label>
                    <input id="register-password" name="new-password" class="input" type="@(_showPassword ? "text" : "password")"
                           autocomplete="new-password" maxlength="512" aria-describedby="register-password-hint" @ref="_passwordInput"
                           aria-invalid="@AriaInvalid(RegistrationField.Password)"
                           @bind="_password" @bind:event="oninput" />
                    <p class="ss-desc" id="register-password-hint" style="font-size:0.8rem; margin-top:0">@P.PasswordHint</p>
                    <label class="toggle-row" style="gap:0.5rem; font-size:0.85rem;">
                        <input type="checkbox" @bind="_showPassword" />
                        <span>@P.ShowPassword</span>
                    </label>
                    <button type="submit" class="btn-primary" disabled="@_busy">
                        @(_busy ? T.LoginWorking : P.RegisterPasswordButton)
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn-primary" @onclick="RegisterAsync" disabled="@_busy">
                    @(_busy ? T.LoginWorking : T.RegisterButton)
                </button>
            }
            <a href="@("/login" + _app.LinkQuery)" class="btn-secondary" style="text-align:center;">@T.GoToLoginLink</a>
            <a href="@("/link" + _app.LinkQuery)" class="btn-secondary" style="text-align:center;">@T.GoToLinkDeviceLink</a>
        </div>
        @* iOS PWA hint: Safari clears localStorage of "normal" website tabs after 7 days of
           inactivity, but not for installed home-screen apps - without installation, the
           90-day session on iOS would therefore be practically worthless. *@
        <p class="ss-desc" style="margin-top:1.5rem; font-size:0.8rem; color:var(--text3);">@T.InstallHint</p>
    </div>
</div>
}

@code {
    private string _displayName = "";
    private string _setupSecret = "";

    // Username + password registration (shown only when the server offers it, api/auth/methods).
    private StudyLife.Client.I18nText.PasswordText? P;
    private bool _passwordOffered;
    private Reasker? _offerAsker;
    private bool _usePassword;
    private bool _showPassword;
    private string _username = "";
    private string _password = "";
    private bool _busy;
    private string? _error;
    private IReadOnlyList<RegistrationField> _missing = [];
    private ElementReference _nameInput;
    private ElementReference _usernameInput;
    private ElementReference _passwordInput;
    private IJSObjectReference? _module;

    // App return path (?app=1) as in Login.razor: the page runs in the native app's system
    // browser. Name/setup secret then arrive pre-filled via URL fragment (fragments never end
    // up in server logs), the token goes back via redirect (details in AppReturnContext).
    private AppReturnContext _app = AppReturnContext.FromUri(new Uri("https://unused.invalid/"));

    // Registration gate (audit finding A10): the invite token travels as a URL query parameter
    // ("/register?invite=<token>", see AuthController.CreateInvite/InviteListItemDto) so the
    // link is a single thing to share - no separate "enter this code" step. Read once here and
    // forwarded unchanged through both begin and complete.
    private string? _inviteToken;

    protected override Task OnInitializingAsync()
    {
        // Pure, T-independent computation - safe to run alongside the text-table fetch
        // (same "start work immediately" idiom as Index.razor.cs/Setup.razor).
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _app = AppReturnContext.FromUri(uri);
        _inviteToken = System.Web.HttpUtility.ParseQueryString(uri.Query)["invite"];
        if (_app.IsActive && uri.Fragment is { Length: > 1 } fragment)
        {
            foreach (var pair in fragment.TrimStart('#').Split('&'))
            {
                var kv = pair.Split('=', 2);
                if (kv.Length != 2) continue;
                if (kv[0] == "name") _displayName = Uri.UnescapeDataString(kv[1]);
                else if (kv[0] == "secret") _setupSecret = Uri.UnescapeDataString(kv[1]);
            }
        }
        return Task.CompletedTask;
    }

    private string? AriaInvalid(RegistrationField field) => _missing.Contains(field) ? "true" : null;

    /// <summary>Checks the required fields for the chosen method (one validator for both paths).
    /// On a gap: names the missing fields inline, marks them aria-invalid and moves focus to the
    /// first one, so the always-enabled button never looks dead. Returns true when the form is complete.</summary>
    private async Task<bool> ValidateAsync(bool usePassword)
    {
        _missing = RegistrationValidator.MissingFields(_displayName, _username, _password, usePassword);
        if (_missing.Count == 0) return true;

        var labels = _missing.Select(f => f switch
        {
            RegistrationField.DisplayName => T.DisplayNameLabel,
            RegistrationField.Username => P?.UsernameLabel,
            _ => P?.PasswordLabel,
        });
        _error = $"{T.RegisterMissingFields} {string.Join(", ", labels.Where(l => !string.IsNullOrEmpty(l)))}";
        StateHasChanged();
        var first = _missing[0] switch
        {
            RegistrationField.DisplayName => _nameInput,
            RegistrationField.Username => _usernameInput,
            _ => _passwordInput,
        };
        try { await first.FocusAsync(); }
        catch (JSException) { /* focus is a nicety only */ }
        return false;
    }

    /// <summary>Maps RegistrationGateErrorDto.Reason (audit A10) to the matching localized
    /// message - "invite_required" reuses the same text as "closed" (from the user's point of
    /// view both mean "you can't just sign up here"), only "invite_invalid" gets its own,
    /// more actionable message since the user DID follow a link.</summary>
    private string GateErrorMessage(string? reason) => reason switch
    {
        "invite_invalid" => T.RegisterInviteInvalid ?? T.RegisterFailed,
        "invite_required" => T.RegisterInviteRequiredHint ?? T.RegisterFailed,
        _ => T.RegisterClosed ?? T.RegisterFailed,
    };

    protected override async Task OnTextLoadedAsync()
    {
        P = await I18nText.GetTextTableAsync<StudyLife.Client.I18nText.PasswordText>(this);
        // The method choice waits for the server's answer and re-asks while it cannot be asked (offline).
        _offerAsker = new Reasker(AskOfferAsync, Services.GetService<IConnectivitySignal>());
        await _offerAsker.StartAsync();
    }

    private async Task<ReaskVerdict> AskOfferAsync(CancellationToken ct)
    {
        var offer = await new PasswordSignInState(Http).GetOfferAsync(ct);
        if (offer == PasswordOffer.Unknown) return ReaskVerdict.Retry;
        _passwordOffered = offer == PasswordOffer.Offered;
        await InvokeAsync(StateHasChanged);
        return ReaskVerdict.Done;
    }

    public void Dispose() => _offerAsker?.Dispose();

    /// <summary>Registration with a username and password instead of a passkey - also inside the
    /// native shells' web view, which needs no system browser for it (no WebAuthn involved). Same
    /// gates as the passkey path; the token is handled exactly like after a passkey registration.</summary>
    private async Task RegisterWithPasswordAsync()
    {
        if (_busy || P is null) return;
        if (!await ValidateAsync(usePassword: true)) return;
        var displayName = _displayName.Trim();
        _busy = true;
        _error = null;
        _missing = [];
        try
        {
            var attempt = await new PasswordSignInState(Http)
                .RegisterAsync(displayName, _username, _password, _setupSecret, _inviteToken);
            if (!attempt.Succeeded)
            {
                _error = attempt.Failure switch
                {
                    PasswordFailure.SetupSecretInvalid => T.SetupSecretInvalid,
                    PasswordFailure.RegistrationGate => GateErrorMessage(attempt.GateReason),
                    _ => PasswordSignInState.Message(attempt.Failure, P),
                };
                return;
            }
            _password = "";

            if (_app.IsActive)
            {
                Nav.NavigateTo(await _app.BuildTokenReturnRedirectAsync(Http, attempt.Token!), forceLoad: true);
                return;
            }
            await TokenStore.SetTokenAsync(attempt.Token!);
            Nav.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> TryHandleGateErrorAsync(HttpResponseMessage response)
    {
        if (response.StatusCode != System.Net.HttpStatusCode.Forbidden) return false;
        var gate = await response.Content.ReadFromJsonAsync<RegistrationGateErrorDto>();
        _error = GateErrorMessage(gate?.Reason);
        return true;
    }

    private async Task RegisterAsync()
    {
        if (_busy) return;
        if (!await ValidateAsync(usePassword: false)) return;
        var displayName = _displayName.Trim();
        _missing = [];

        // Native app shell without in-app passkeys (free signing): ceremony runs via the
        // system browser, inputs travel along as a fragment (see the _app comment above).
        // With in-app passkeys the normal flow below runs, only the WebAuthn call goes
        // to the native dialog. Always false on the web.
        if (NativeAuth.IsAvailable && !NativeAuth.SupportsInAppPasskeys)
        {
            await NativeRegisterAsync(displayName);
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (!NativeAuth.SupportsInAppPasskeys)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Login.razor.js");
                if (!await _module.InvokeAsync<bool>("isPasskeySupported"))
                {
                    _error = T.NotSupported;
                    return;
                }
            }

            var begin = await Http.PostAsJsonAsync("api/auth/register/begin",
                new PasskeyRegisterBeginRequestDto { DisplayName = displayName, SetupSecret = _setupSecret.Trim(), InviteToken = _inviteToken });
            if (begin.StatusCode == System.Net.HttpStatusCode.Unauthorized) { _error = T.SetupSecretInvalid; return; }
            if (await TryHandleGateErrorAsync(begin)) return;
            if (!begin.IsSuccessStatusCode) { _error = T.RegisterFailed; return; }
            var options = await begin.Content.ReadFromJsonAsync<PasskeyBeginResponseDto>();
            if (options == null) { _error = T.RegisterFailed; return; }

            var attestationJson = NativeAuth.SupportsInAppPasskeys
                ? await NativeAuth.CreatePasskeyAsync(options.OptionsJson)
                : await _module!.InvokeAsync<string>("createPasskey", options.OptionsJson);
            if (attestationJson == null) { _error = T.RegisterFailed; return; } // native dialog cancelled
            var body = new JsonObject
            {
                ["optionsId"] = options.OptionsId,
                ["response"] = JsonNode.Parse(attestationJson),
            };
            var complete = await Http.PostAsync("api/auth/register/complete",
                new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"));
            if (await TryHandleGateErrorAsync(complete)) return;
            if (!complete.IsSuccessStatusCode) { _error = T.RegisterFailed; return; }

            var result = await complete.Content.ReadFromJsonAsync<PasskeyCompleteResponseDto>();
            if (result?.Token is not { Length: > 0 } token) { _error = T.RegisterFailed; return; }

            if (_app.IsActive)
            {
                // Hand the token back to the native app instead of storing it in this browser
                // session (same pattern as Login.razor, PKCE handoff when supported).
                Nav.NavigateTo(await _app.BuildTokenReturnRedirectAsync(Http, token), forceLoad: true);
                return;
            }

            await TokenStore.SetTokenAsync(token);
            // Registration issues a session directly (see AuthController) - no second passkey
            // dialog. forceLoad for the same reason as in Login.
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (JSException)
        {
            _error = T.RegisterFailed;
        }
        catch (HttpRequestException)
        {
            _error = T.RegisterFailed;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NativeRegisterAsync(string displayName)
    {
        _busy = true;
        _error = null;
        try
        {
            var start = $"register#name={Uri.EscapeDataString(displayName)}&secret={Uri.EscapeDataString(_setupSecret.Trim())}";
            var token = await NativeAuth.AuthenticateAsync(start);
            if (token is { Length: > 0 })
            {
                await TokenStore.SetTokenAsync(token);
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }
            _error = T.RegisterFailed;
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/notes"
@using System.Net
@using System.Text
@using Markdig
@using StudyLife.Client.Models
@using StudyLife.Client.Services
@using StudyLife.Shared
@inherits LocalizedComponentBase<I18nText.NotesText>
@inject HttpClient Http
@inject AppStateService State
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (IsTextLoaded)
{
<PageTitle>@T.PageTitle</PageTitle>

@if (_printView)
{
    <!-- Print view as a PDF substitute: no PDF library, print.css + window.print() via the
         printPage() interop already present in index.html - same technique as Report.razor. -->
    <div class="notes-print-toolbar no-print">
        <button class="btn-secondary" @onclick="ClosePrintView">@T.PrintBackButton</button>
        <button class="btn-primary" @onclick="PrintNow">@T.PrintNowButton</button>
    </div>
    <div class="notes-print-doc">
        <div class="notes-print-head">
            <h1>@T.PageHeading</h1>
            <div class="notes-print-meta">@string.Format(T.PrintGeneratedOnFormat ?? "", DateTime.Now.ToString("dd.MM.yyyy HH:mm"))</div>
        </div>
        @if (PrintGroups.Count == 0)
        {
            <p>@T.NoMatchingNotes</p>
        }
        @foreach (var group in PrintGroups)
        {
            <div class="notes-print-group">
                <h2>@(group.Course != null ? $"{group.Course.Icon} {group.Course.Name}" : T.NoCourse)</h2>
                @foreach (var n in group.Notes)
                {
                    <div class="notes-print-card">
                        <div class="notes-print-card-title">@(string.IsNullOrWhiteSpace(n.Title) ? (T.Untitled ?? "") : n.Title)</div>
                        <div class="notes-print-card-meta">@n.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        @if (n.IsMarkdown)
                        {
                            <div class="notes-print-card-content notes-print-card-content--markdown">@RenderMarkdown(n.Content)</div>
                        }
                        else
                        {
                            <div class="notes-print-card-content">@n.Content</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="setup-page notes-wide">
        <div class="setup-header" style="display:flex;align-items:flex-start;justify-content:space-between">
            <div>
                <h1>@T.PageHeading</h1>
                <p>@T.Subtitle</p>
            </div>
            <div style="display:flex;gap:0.5rem">
                <button class="btn-secondary" @onclick="OpenExportModal">@T.ExportPdfLabel</button>
                <button class="btn-primary" @onclick="NewNote">@T.NewNoteButton</button>
            </div>
        </div>

        <div class="notes-cols">
            <!-- Note list -->
            <div class="setup-section notes-list-section">
                <div class="ss-label">@T.AllNotes</div>
                <div class="notes-filter-row">
                    <input class="input" type="text" placeholder="@T.SearchPlaceholder" @bind="_searchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" />
                    @if (_coursesLoading)
                    {
                        <div class="sl-skeleton sl-skeleton-sm" aria-hidden="true"></div>
                    }
                    else
                    {
                        <select class="select" @bind="_filterCourseId">
                            <option value="0">@T.AllCoursesOption</option>
                            @foreach (var c in _courses)
                            {
                                <option value="@c.Id">@c.Icon @c.Name</option>
                            }
                        </select>
                    }
                </div>
                @if (_notesLoading)
                {
                    <div class="notes-list-scroll sl-skeleton sl-skeleton-lg" aria-hidden="true"></div>
                }
                else
                {
                    @if (_notes.Count == 0 && _selectedNote == null)
                    {
                        <div style="color:var(--text3);font-size:0.875rem;padding:0.5rem 0">
                            @T.NoNotesYet
                        </div>
                    }
                    else if (FilteredNotes.Count == 0)
                    {
                        <div style="color:var(--text3);font-size:0.875rem;padding:0.5rem 0">
                            @T.NoMatchingNotes
                        </div>
                    }
                    <div class="notes-list-scroll">
                        <Virtualize Items="FilteredNotes" Context="note" ItemSize="84">
                            @{
                                var n = note;
                                var isActive = _selectedNote?.Id == n.Id;
                            }
                            <div class="note-row @(isActive ? "note-row--active" : "")" @onclick="() => SelectNote(n)">
                                <div class="note-row__title">@GetHighlightedTitle(n)</div>
                                <div class="note-row__meta">
                                    @if (n.CourseId.HasValue)
                                    {
                                        var course = _courses.FirstOrDefault(c => c.Id == n.CourseId);
                                        if (course != null)
                                        {
                                            <span class="topic-pill" style="--c:@course.Color;background:color-mix(in srgb,var(--c) 12%,transparent);color:var(--c)">@course.Icon @course.Code</span>
                                        }
                                    }
                                    <span style="color:var(--text3);font-size:0.75rem">@FormatDate(n.UpdatedAt)</span>
                                    @if (n.SessionId.HasValue)
                                    {
                                        <span class="note-linked-badge" title="@T.LinkedToSessionHint">🔗</span>
                                    }
                                </div>
                                <div class="note-row__preview">@GetHighlightedPreview(n)</div>
                            </div>
                        </Virtualize>
                    </div>
                }
            </div>

            <!-- Editor: gated on _notesLoading too (not just _selectedNote != null) - otherwise
                 the "select a note" empty state would flash before the notes list has even
                 loaded, misleadingly implying there's nothing to select. -->
            @if (_notesLoading)
            {
                <div class="setup-section notes-editor-section sl-skeleton sl-skeleton-xl" aria-hidden="true"></div>
            }
            else if (_selectedNote != null)
            {
                <div class="setup-section notes-editor-section">
                    <div class="ss-label" style="display:flex;justify-content:space-between;align-items:center">
                        <span>
                            @(_selectedNote.Id == 0 ? T.NewNoteHeader : T.Edit)
                            @if (_selectedNote.SessionId.HasValue)
                            {
                                <span class="note-linked-badge" title="@T.LinkedToSessionHint">🔗</span>
                            }
                        </span>
                        <div style="display:flex;gap:0.75rem;align-items:center">
                            @if (_saving)
                            {
                                <span style="color:var(--accent);font-size:0.75rem">@T.Saved</span>
                            }
                            @if (_saveFailed)
                            {
                                <span style="color:var(--danger,#e74c3c);font-size:0.75rem">⚠️ @T.SaveFailed</span>
                            }
                            @if (_confirmingDelete)
                            {
                                <div class="note-confirm-delete">
                                    <span class="note-confirm-delete__question">@T.ConfirmDeleteNoteQuestion</span>
                                    <button class="btn-secondary" style="font-size:0.8rem;padding:0.3rem 0.75rem;border-radius:6px" @onclick="CancelDeleteNote">@T.ConfirmDeleteCancel</button>
                                    <button class="btn-danger" style="font-size:0.8rem;padding:0.3rem 0.75rem;border-radius:6px" @onclick="ConfirmDeleteNote">@T.ConfirmDeleteYes</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn-danger" style="font-size:0.8rem;padding:0.3rem 0.75rem;border-radius:6px" @onclick="DeleteNote">@T.Delete</button>
                            }
                        </div>
                    </div>

                    <div class="field" style="margin-bottom:0.75rem">
                        <label style="font-size:0.75rem;color:var(--text2);margin-bottom:0.3rem;display:block">@T.TitleLabel</label>
                        <input class="input"
                               type="text"
                               placeholder="@T.NoteTitlePlaceholder"
                               @bind="_editTitle"
                               @bind:event="oninput"
                               @bind:after="ScheduleSave" />
                    </div>

                    <div class="field" style="margin-bottom:0.75rem">
                        <label style="font-size:0.75rem;color:var(--text2);margin-bottom:0.3rem;display:block">@T.CourseLabel</label>
                        <select @bind="_editCourseId" class="select">
                            <option value="0">@T.NoCourse</option>
                            @foreach (var c in _courses)
                            {
                                <option value="@c.Id">@c.Icon @c.Name</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(_selectedNote.SourceUrl) || !string.IsNullOrEmpty(_selectedNote.Tags) || !string.IsNullOrEmpty(_selectedNote.Summary) || RelatedNotes.Count > 0)
                    {
                        <div class="note-capture-meta">
                            @if (!string.IsNullOrEmpty(_selectedNote.SourceUrl))
                            {
                                <a href="@_selectedNote.SourceUrl" target="_blank" rel="noopener noreferrer" class="note-source-link">🔗 @T.CaptureSourceLinkLabel</a>
                            }
                            @if (!string.IsNullOrEmpty(_selectedNote.Tags))
                            {
                                <div class="note-tags">
                                    @foreach (var tag in _selectedNote.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="note-tag-pill">@tag</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_selectedNote.Summary))
                            {
                                <p class="note-summary">@_selectedNote.Summary</p>
                            }
                            @if (RelatedNotes.Count > 0)
                            {
                                <div class="note-related">
                                    <span class="note-related__label">@T.RelatedNotesLabel</span>
                                    @foreach (var related in RelatedNotes)
                                    {
                                        <button type="button" class="note-related__link" @onclick="() => SelectNote(related)">@related.Title</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="field">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.3rem">
                            <label style="font-size:0.75rem;color:var(--text2)">@T.ContentLabel</label>
                            <div style="display:flex;gap:0.5rem;align-items:center">
                                <div class="notes-format-switch">
                                    <button type="button" class="notes-format-opt @(!_editIsMarkdown ? "active" : "")" @onclick="() => SetFormat(false)">@T.FormatTextOption</button>
                                    <button type="button" class="notes-format-opt @(_editIsMarkdown ? "active" : "")" @onclick="() => SetFormat(true)">@T.FormatMarkdownOption</button>
                                </div>
                                @if (_editIsMarkdown)
                                {
                                    <button type="button" class="btn-secondary" style="font-size:0.75rem;padding:0.25rem 0.6rem;border-radius:6px" @onclick="() => _showMarkdownPreview = !_showMarkdownPreview">
                                        @(_showMarkdownPreview ? T.Edit : T.ShowPreviewButton)
                                    </button>
                                }
                            </div>
                        </div>
                        <div style="display:flex;justify-content:flex-end;gap:0.5rem;align-items:center;margin-bottom:0.4rem">
                            @if (_selectedNote?.Id > 0)
                            {
                                <button type="button" class="btn-secondary" style="font-size:0.75rem;padding:0.25rem 0.6rem;border-radius:6px" disabled="@_ttsLoading" @onclick="PlayNoteAudio">
                                    🔊 @(_ttsLoading ? T.ReadAloudLoading : T.ReadAloudButton)
                                </button>
                            }
                            <button type="button" id="note-dictate-btn" class="btn-secondary @(_dictationRecording ? "note-dictate-recording" : "")" style="font-size:0.75rem;padding:0.25rem 0.6rem;border-radius:6px" disabled="@_dictationProcessing" @onclick="ToggleDictation">
                                @if (_dictationRecording)
                                {
                                    <text>⏹️ @T.DictateStopButton</text>
                                }
                                else if (_dictationProcessing)
                                {
                                    <text>🎙️ @T.DictateProcessing</text>
                                }
                                else
                                {
                                    <text>🎙️ @T.DictateButton</text>
                                }
                            </button>
                        </div>
                        @if (_editIsMarkdown && _showMarkdownPreview)
                        {
                            <div class="input note-textarea note-markdown-preview">@RenderMarkdown(_editContent)</div>
                        }
                        else
                        {
                            <textarea class="input note-textarea"
                                      placeholder="@T.ContentPlaceholder"
                                      @bind="_editContent"
                                      @bind:event="oninput"
                                      @bind:after="ScheduleSave"></textarea>
                        }
                        @if (_dictationUnavailable)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">@T.DictateUnavailable</div>
                        }
                        else if (_dictationFailed)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">@T.DictateFailed</div>
                        }
                        else if (_dictationSilent)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">@T.DictateSilent</div>
                        }
                        else if (_dictationRecording && _dictationUsingBrowserFallback)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">🎙️ @T.DictateBrowserVoice</div>
                        }
                        @if (_ttsAudioUrl != null)
                        {
                            <audio controls autoplay src="@_ttsAudioUrl" style="width:100%;margin-top:0.5rem"></audio>
                        }
                        else if (_ttsBrowserFallbackActive)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">🔊 @T.ReadAloudBrowserVoice</div>
                        }
                        else if (_ttsUnavailable)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">@T.ReadAloudUnavailable</div>
                        }
                        else if (_ttsTimedOut)
                        {
                            <div style="font-size:0.75rem;color:var(--text3);margin-top:0.5rem">@T.ReadAloudTimeout</div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="setup-section" style="display:flex;align-items:center;justify-content:center;min-height:200px;color:var(--text3)">
                    <div style="text-align:center">
                        <div style="font-size:2rem;color:var(--accent);opacity:0.3;margin-bottom:0.5rem">◪</div>
                        <div style="font-size:0.875rem">@T.SelectNotePrompt</div>
                    </div>
                </div>
            }
        </div>

        @if (_showExportModal)
        {
            <div class="modal-overlay" @onclick="CloseExportModal">
                <div class="modal" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@T.ExportPdfLabel</h3>
                        <button type="button" class="modal-close" @onclick="CloseExportModal">✕</button>
                    </div>
                    <div class="modal-body">
                        <p class="ss-desc">@T.ExportPdfModalDesc</p>
                        <div class="field">
                            <label style="font-size:0.75rem;color:var(--text2);margin-bottom:0.3rem;display:block">@T.CourseLabel</label>
                            <select class="select" @bind="_exportCourseId">
                                <option value="0">@T.AllCoursesOption</option>
                                @foreach (var c in _courses)
                                {
                                    <option value="@c.Id">@c.Icon @c.Name</option>
                                }
                            </select>
                        </div>
                        <div style="font-size:0.8rem;color:var(--text3)">
                            @string.Format(T.ExportSelectionCount ?? "", PrintCandidateNotes.Count)
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseExportModal">@T.ConfirmDeleteCancel</button>
                        <button type="button" class="btn-primary" @onclick="StartPrintPreview">@T.ExportPreviewButton</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
}

@code {
    // Progressive render: page shell (header/toolbar/search) paints as soon as text loads,
    // before settings/courses/notes have arrived - see the loading flags below.
    protected override bool RenderShellBeforeData => true;

    private List<NoteDto> _notes = new();
    private List<CourseDto> _courses = new();
    private NoteDto? _selectedNote;

    // Phase 1 (settings + courses): gates the course filter dropdown, whose options come from
    // _courses. Phase 2 (_loadNotesTask): gates the notes list/editor columns, so the "no notes
    // yet"/"select a note" empty states can't flash before the real list has loaded.
    private bool _coursesLoading = true;
    private bool _notesLoading = true;

    private string _editTitle = "";
    private string _editContent = "";
    private int _editCourseId = 0;
    private bool _editIsMarkdown;
    private bool _showMarkdownPreview;
    private bool _ttsLoading;
    private string? _ttsAudioUrl;
    private bool _ttsUnavailable;
    private bool _ttsTimedOut;
    private bool _ttsBrowserFallbackActive;
    private bool _dictationRecording;
    private bool _dictationProcessing;
    private bool _dictationUnavailable;
    private bool _dictationFailed;
    private bool _dictationSilent;
    private bool _saving;
    private bool _saveFailed;
    private bool _confirmingDelete;
    private System.Threading.Timer? _debounce;
    private System.Threading.Timer? _searchDebounce;
    private string _searchQuery = "";
    private int _filterCourseId = 0;
    private List<NoteDto>? _searchResults; // null = no active search, otherwise server FTS hits

    // Empty search: normal _notes list as before. Non-empty search: server FTS result
    // (relevance-sorted), the course filter stays layered on top client-side in both cases.
    // Active-programme scope: general notes (no CourseId) always stay visible,
    // course-bound ones only if the course belongs to the active programme (_allProgramCourseIds).
    private List<NoteDto> FilteredNotes =>
        (string.IsNullOrWhiteSpace(_searchQuery) ? _notes : _searchResults ?? new List<NoteDto>())
        .Where(n => !n.CourseId.HasValue || _allProgramCourseIds.Contains(n.CourseId.Value))
        .Where(n => _filterCourseId == 0 || n.CourseId == _filterCourseId)
        .ToList();

    private HashSet<int> _allProgramCourseIds = new();

    private bool _showExportModal;
    private bool _printView;
    private int _exportCourseId = 0;

    // Candidates for the PDF export: same programme scope as FilteredNotes, additionally
    // narrowable via the course filter in the modal. Notes with neither a title NOR content would be an
    // empty entry in the document and are therefore skipped.
    private List<NoteDto> PrintCandidateNotes =>
        _notes
            .Where(n => !n.CourseId.HasValue || _allProgramCourseIds.Contains(n.CourseId.Value))
            .Where(n => _exportCourseId == 0 || n.CourseId == _exportCourseId)
            .Where(n => !string.IsNullOrWhiteSpace(n.Title) || !string.IsNullOrWhiteSpace(n.Content))
            .ToList();

    /// <summary>Record struct instead of a value tuple for PrintGroups below - LINQ over a
    /// List<(...)> of value tuples has triggered a Mono AOT crash at compile time (not call time)
    /// in the native app shell (studylife-app, BlazorWebView) that links this same Client project -
    /// see project_studylife_app_ios_aot_linq_tuple_crash.</summary>
    private readonly record struct NotePrintGroup(CourseDto? Course, List<NoteDto> Notes);

    // Grouped by course for the print view (general notes without a course first, then
    // the courses alphabetically) - reads much better as a document than a flat list.
    private List<NotePrintGroup> PrintGroups =>
        PrintCandidateNotes
            .GroupBy(n => n.CourseId)
            .Select(g => new NotePrintGroup(
                g.Key.HasValue ? _courses.FirstOrDefault(c => c.Id == g.Key.Value) : null,
                g.OrderByDescending(n => n.UpdatedAt).ToList()))
            .OrderBy(g => g.Course == null ? 0 : 1)
            .ThenBy(g => g.Course?.Name ?? "")
            .ToList();

    private void OpenExportModal()
    {
        _exportCourseId = _filterCourseId;
        _showExportModal = true;
    }

    private void CloseExportModal() => _showExportModal = false;

    private void StartPrintPreview()
    {
        _showExportModal = false;
        _printView = true;
    }

    private void ClosePrintView() => _printView = false;

    private async Task PrintNow()
    {
        // printPage() already lives in index.html (best-effort window.print() wrapper, see
        // Report.razor.cs) - no new JS interop needed.
        try { await JS.InvokeVoidAsync("printPage"); } catch { /* best-effort, ignore */ }
    }

    // Independent of each other, and of the text-table fetch that LocalizedComponentBase starts
    // in parallel - kicked off here (OnInitializingAsync, runs alongside that fetch) instead of
    // await-ing one after another once text has loaded, same pattern as Index.razor.cs/Setup.razor.
    private Task<UserSettings>? _settingsTask;
    private Task<List<CourseDto>>? _coursesTask;
    private Task? _loadNotesTask;

    // Another device (or an add-on) changed notes: reload the list but keep the note that is
    // open in the editor as the selection, so live updates never take the cursor away. Our own
    // saves are filtered on the service side (State.NoteOwnWrite) and do not come through here.
    private void OnServerChanged(string? kind)
    {
        if (kind is not null && kind != "notes") return;
        _ = InvokeAsync(async () =>
        {
            var previous = _selectedNote;
            await LoadNotes();
            if (previous is { Id: > 0 } && _notes.FirstOrDefault(n => n.Id == previous.Id) is { } fresh && _selectedNote?.Id == previous.Id)
            {
                // Editor untouched since the last load/save: show the other device's version.
                // Unsaved edits win instead - the entity is swapped so the next save targets the
                // current server row, but the text the user is typing is never replaced.
                var clean = _editTitle == previous.Title && _editContent == previous.Content
                    && _editCourseId == (previous.CourseId ?? 0) && _editIsMarkdown == previous.IsMarkdown;
                if (clean) SelectNote(fresh);
                else _selectedNote = fresh;
            }
            StateHasChanged();
        });
    }

    protected override Task OnInitializingAsync()
    {
        _settingsTask = State.GetSettingsAsync();
        _coursesTask = State.GetCoursesAsync();
        _loadNotesTask = LoadNotes();
        State.OnServerChanged += OnServerChanged;
        return Task.CompletedTask;
    }

    protected override async Task OnTextLoadedAsync()
    {
        // ── Phase 1: settings + courses - cheap enough to be the first thing the filter
        // dropdown shows.
        var settings = await _settingsTask!;
        var allCourses = await _coursesTask!;
        _allProgramCourseIds = allCourses.Select(c => c.Id).ToHashSet();
        _courses = allCourses
            .Where(c => settings.SelectedCourseIds.Contains(c.Id) || settings.CompletedCourseIds.Contains(c.Id))
            .ToList();
        _coursesLoading = false;
        await RenderPhaseAsync();

        // ── Phase 2: the notes list itself (already started in OnInitializingAsync).
        await _loadNotesTask!;
        _notesLoading = false;
        await RenderPhaseAsync();

        // PWA app-icon shortcut ("New note") links here with ?new=1 to jump straight into a fresh note.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (System.Web.HttpUtility.ParseQueryString(uri.Query)["new"] == "1")
        {
            NewNote();
        }
    }

    private const string NotesReadCacheKey = "studylife-cache-notes";

    private async Task LoadNotes()
    {
        try
        {
            _notes = await Http.GetFromJsonAsync<List<NoteDto>>("api/notes") ?? new();
            await State.StoreReadCacheAsync(NotesReadCacheKey, _notes);
        }
        catch
        {
            // Offline cold start: last successful server state instead of an empty list
            // (same rule as in AppStateService: read the cache ONLY on the error path).
            _notes = await State.LoadReadCacheAsync<List<NoteDto>>(NotesReadCacheKey) ?? new();
        }
    }

    private void NewNote()
    {
        _selectedNote = new NoteDto { Id = 0, Title = "", Content = "", CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now };
        _editTitle = "";
        _editContent = "";
        _editCourseId = 0;
        _editIsMarkdown = false;
        _showMarkdownPreview = false;
        _confirmingDelete = false;
        ResetTtsState();
    }

    // Resolved against the already-loaded _notes list (no extra API call) - a related note may
    // since have been deleted, in which case it's simply not found and silently skipped rather
    // than needing NoteEntity.RelatedNoteIds to be kept in sync with deletions.
    private List<NoteDto> RelatedNotes =>
        _selectedNote?.RelatedNoteIds
            .Select(id => _notes.FirstOrDefault(n => n.Id == id))
            .Where(n => n != null)
            .Cast<NoteDto>()
            .ToList()
        ?? new List<NoteDto>();

    private void SelectNote(NoteDto note)
    {
        _selectedNote = note;
        _editTitle = note.Title;
        _editContent = note.Content;
        _editCourseId = note.CourseId ?? 0;
        _editIsMarkdown = note.IsMarkdown;
        _showMarkdownPreview = note.IsMarkdown;
        _confirmingDelete = false;
        ResetTtsState();
        ResetDictationState();
    }

    private void ResetTtsState()
    {
        _ttsLoading = false;
        _ttsAudioUrl = null;
        _ttsUnavailable = false;
        _ttsTimedOut = false;
        _ttsBrowserFallbackActive = false;
    }

    private void ResetDictationState()
    {
        _dictationAutoStopTimer?.Dispose();
        _dictationAutoStopTimer = null;
        // Switching notes mid-recording would otherwise leave the recorder (MediaRecorder or
        // browser SpeechRecognition, and the browser's mic-active indicator) running in the
        // background, recording into a note that's no longer even selected - stop it, don't just
        // forget about it client-side.
        if (_dictationRecording)
        {
            _ = JS.InvokeVoidAsync(_dictationUsingBrowserFallback
                ? "stopBrowserSpeechRecognition"
                : "cancelDictationRecording");
        }
        _dictationRecording = false;
        _dictationProcessing = false;
        _dictationUnavailable = false;
        _dictationFailed = false;
        _dictationSilent = false;
        _dictationUsingBrowserFallback = false;
    }

    // BCP-47 tags for the Web Speech API fallback - the app's own language codes (used
    // throughout for i18n and the TTS endpoint's ?lang=) are plain ISO 639-1, but
    // SpeechSynthesisUtterance.lang wants a full locale tag to pick the right OS voice.
    private static readonly Dictionary<string, string> SpeechLocales = new()
    {
        ["en"] = "en-US", ["de"] = "de-DE", ["fr"] = "fr-FR", ["es"] = "es-ES", ["it"] = "it-IT",
        ["pt"] = "pt-PT", ["nl"] = "nl-NL", ["da"] = "da-DK", ["sv"] = "sv-SE", ["fi"] = "fi-FI",
        ["el"] = "el-GR", ["pl"] = "pl-PL", ["cs"] = "cs-CZ", ["sk"] = "sk-SK", ["hu"] = "hu-HU",
        ["ro"] = "ro-RO", ["bg"] = "bg-BG", ["hr"] = "hr-HR", ["sl"] = "sl-SI", ["et"] = "et-EE",
        ["lv"] = "lv-LV", ["lt"] = "lt-LT", ["mt"] = "mt-MT", ["ga"] = "ga-IE", ["uk"] = "uk-UA",
        ["ru"] = "ru-RU",
    };

    private async Task PlayNoteAudio()
    {
        if (_selectedNote == null || _selectedNote.Id <= 0) return;
        _ttsLoading = true;
        _ttsAudioUrl = null;
        _ttsUnavailable = false;
        _ttsTimedOut = false;
        _ttsBrowserFallbackActive = false;
        StateHasChanged();
        var lang = await I18nText.GetCurrentLanguageAsync();
        try
        {
            _ttsAudioUrl = await FetchAudioDataUrl(_selectedNote.Id, lang);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            // No server-side voice for this language (see docs/TTS-VOICES.md) - fall back to
            // the browser's own synthesis instead of just telling the user it's unavailable.
            await TryBrowserSpeechFallback(lang);
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            // A long note's first (uncached) synthesis can take a while on the Pi cluster's
            // real ARM CPU - long enough to exceed the gateway's own read timeout more than
            // once in a row, confirmed live - even though the server keeps working and caches
            // the result once done regardless of whether any particular client is still
            // listening (TtsController now also dedupes concurrent/retried requests for the
            // same content server-side, so a retry waits on the one synthesis already running
            // instead of starting a competing one). Retry several times with a pause between
            // attempts instead of giving up after one.
            var succeeded = false;
            for (var attempt = 0; attempt < MaxRetries && !succeeded; attempt++)
            {
                await Task.Delay(RetryDelay);
                try
                {
                    _ttsAudioUrl = await FetchAudioDataUrl(_selectedNote.Id, lang);
                    succeeded = true;
                }
                catch
                {
                    // keep trying
                }
            }
            if (!succeeded) _ttsTimedOut = true;
        }
        finally
        {
            _ttsLoading = false;
        }
    }

    private const int MaxRetries = 5;
    private static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(25);
    // Longer than HttpClient's 100s default - short enough that a long note's synthesis
    // legitimately exceeds it (that's what the retry loop above is for), but without this a
    // Blazor WASM HttpClient would give up client-side before the gateway's own (already
    // raised) read timeout does, throwing a plain OperationCanceledException instead of a
    // proper HttpRequestException with a status code to react to.
    private static readonly TimeSpan PerAttemptTimeout = TimeSpan.FromSeconds(200);

    private async Task<string> FetchAudioDataUrl(int noteId, string lang)
    {
        using var cts = new CancellationTokenSource(PerAttemptTimeout);
        var bytes = await Http.GetByteArrayAsync($"api/notes/{noteId}/tts?lang={lang}", cts.Token);
        return $"data:audio/wav;base64,{Convert.ToBase64String(bytes)}";
    }

    private async Task TryBrowserSpeechFallback(string lang)
    {
        var text = ExtractPlainTextForSpeech(_editContent, _editIsMarkdown);
        if (string.IsNullOrWhiteSpace(text))
        {
            _ttsUnavailable = true;
            return;
        }
        var locale = SpeechLocales.GetValueOrDefault(lang, lang);
        var spoke = await JS.InvokeAsync<bool>("speakText", text, locale);
        if (!spoke)
        {
            _ttsUnavailable = true;
            return;
        }
        _ttsBrowserFallbackActive = true;
        // No onend callback wired up (would need a DotNetObjectReference just for a status
        // label) - a rough, length-proportional estimate is enough to clear the indicator
        // without the note staying "playing" long after the browser voice actually finished.
        _ = Task.Delay(TimeSpan.FromMilliseconds(Math.Clamp(text.Length * 65, 1500, 20000))).ContinueWith(_ =>
        {
            _ttsBrowserFallbackActive = false;
            InvokeAsync(StateHasChanged);
        });
    }

    // Voice dictation ("speak instead of type") - the reverse of PlayNoteAudio. Works on notes
    // that aren't saved yet too (unlike read-aloud, which needs a persisted note server-side to
    // read from): transcription only depends on the recorded audio, nothing about the note.
    private async Task ToggleDictation()
    {
        if (_dictationRecording) await StopDictation();
        else await StartDictation();
    }

    // Whisper itself copes fine with long audio memory-wise (measured: ~830MB peak for 6+
    // minutes on the same base model shipped here, no runaway growth like Piper's per-call ONNX
    // cost) - the real problem with letting a dictation run indefinitely is transcription
    // quality, which visibly drifts/degrades the longer (especially the more repetitive) the
    // audio gets. Auto-stopping well before that point is simpler and more predictable than
    // trying to chunk audio client-side purely to work around a memory problem that doesn't
    // actually exist here.
    private static readonly TimeSpan MaxDictationLength = TimeSpan.FromMinutes(3);
    private System.Threading.Timer? _dictationAutoStopTimer;

    private bool _dictationUsingBrowserFallback;

    private async Task StartDictation()
    {
        _dictationUnavailable = false;
        _dictationFailed = false;
        _dictationSilent = false;
        _dictationUsingBrowserFallback = false;
        var lang = await I18nText.GetCurrentLanguageAsync();

        if (await JS.InvokeAsync<bool>("startDictationRecording"))
        {
            _dictationRecording = true;
            _dictationAutoStopTimer = new System.Threading.Timer(
                async _ => await InvokeAsync(async () => await StopDictation()),
                null, MaxDictationLength, Timeout.InfiniteTimeSpan);
            return;
        }

        // No MediaRecorder support, or the user denied/has no microphone - JS can't tell these
        // apart from getUserMedia's rejected promise alone. Before giving up, try the browser's
        // own SpeechRecognition as a last resort (mirrors PlayNoteAudio/speakText's fallback) -
        // worth being explicit that, unlike everything else here, most browsers' implementation
        // sends the audio to their own cloud speech service rather than recognizing it locally.
        var locale = SpeechLocales.GetValueOrDefault(lang, lang);
        if (await JS.InvokeAsync<bool>("startBrowserSpeechRecognition", locale))
        {
            _dictationUsingBrowserFallback = true;
            _dictationRecording = true;
            _dictationAutoStopTimer = new System.Threading.Timer(
                async _ => await InvokeAsync(async () => await StopDictation()),
                null, MaxDictationLength, Timeout.InfiniteTimeSpan);
            return;
        }

        _dictationUnavailable = true;
    }

    private sealed record DictateResponse(string Text);

    private async Task StopDictation()
    {
        if (!_dictationRecording) return; // already stopped (e.g. the auto-stop timer beat a manual click)
        _dictationAutoStopTimer?.Dispose();
        _dictationAutoStopTimer = null;
        _dictationRecording = false;
        _dictationProcessing = true;
        StateHasChanged();
        try
        {
            if (_dictationUsingBrowserFallback)
            {
                var recognized = await JS.InvokeAsync<string>("stopBrowserSpeechRecognition");
                InsertDictatedText(recognized);
                return;
            }

            // JS resamples/encodes to 16 kHz mono WAV client-side (same format PiperVoice
            // already produces server-side) - avoids adding an audio transcoding dependency to
            // the server for what the browser's own Web Audio API already does natively. Null
            // means JS judged the recording essentially silent (RMS gate) and skipped encoding
            // it at all - Whisper's own confidence score can't be trusted to catch this itself,
            // measured directly (see stopDictationRecording's JS comment).
            var wavBase64 = await JS.InvokeAsync<string?>("stopDictationRecording");
            if (wavBase64 == null)
            {
                _dictationSilent = true;
                return;
            }
            var wavBytes = Convert.FromBase64String(wavBase64);

            var lang = await I18nText.GetCurrentLanguageAsync();
            using var content = new MultipartFormDataContent();
            var audioContent = new ByteArrayContent(wavBytes);
            audioContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("audio/wav");
            content.Add(audioContent, "audio", "recording.wav");

            // Longer than HttpClient's 100s default - a Pi transcribing a nearly-3-minute
            // recording (MaxDictationLength) needs real headroom, same reasoning as TTS's
            // PerAttemptTimeout. No retry loop here (unlike PlayNoteAudio): re-uploading the
            // same recording on timeout would just make an already-slow Pi redo the same work.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(150));
            using var response = await Http.PostAsync($"api/dictate?lang={lang}", content, cts.Token);
            if (!response.IsSuccessStatusCode)
            {
                _dictationFailed = true;
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<DictateResponse>();
            InsertDictatedText(result?.Text);
        }
        catch
        {
            _dictationFailed = true;
        }
        finally
        {
            _dictationProcessing = false;
        }
    }

    private void InsertDictatedText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            // Empty transcription (silence, too short, or a garbled recording) - not an error
            // worth alarming the user over, just nothing to insert.
            return;
        }
        _editContent = string.IsNullOrWhiteSpace(_editContent) ? text : $"{_editContent} {text}";
        ScheduleSave();
    }

    // Mirrors StudyLife.Tts's MarkdownToSpeechText.Extract server-side - not shared as a
    // project reference: StudyLife.Tts P/Invokes into a native Linux library (libespeak-ng),
    // which can't run in the Blazor WASM client, so the whole project isn't referenceable
    // from here. This one small piece (Markdig -> plain text) is duplicated instead.
    private static string ExtractPlainTextForSpeech(string? content, bool isMarkdown) =>
        isMarkdown ? Markdown.ToPlainText(content ?? "", MarkdownPipeline) : content ?? "";

    private void SetFormat(bool isMarkdown)
    {
        if (_editIsMarkdown == isMarkdown) return;
        _editIsMarkdown = isMarkdown;
        _showMarkdownPreview = false;
        ScheduleSave();
    }

    // One shared pipeline instance (Markdig recommends reuse - immutable/thread-safe once built).
    // DisableHtml: notes are personal content, not shared with other users - there's no
    // legitimate need for raw HTML embedding, so it's stripped rather than passed through
    // (defense in depth against a pasted <script> tag rendering in the author's own preview/print).
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static MarkupString RenderMarkdown(string content) =>
        new(Markdig.Markdown.ToHtml(content ?? "", MarkdownPipeline));

    private void OnSearchQueryChanged()
    {
        _searchDebounce?.Dispose();
        _searchDebounce = null;

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            // Search cleared: immediately show the normal list again, no server round trip.
            _searchResults = null;
            return;
        }

        // Immediate local interim result (substring filter like before) so the list
        // doesn't briefly go empty while waiting for the debounced FTS result from the server.
        _searchResults = _notes
            .Where(n => n.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                || n.Content.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

        _searchDebounce = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(RunServerSearch);
        }, null, TimeSpan.FromMilliseconds(300), Timeout.InfiniteTimeSpan);
    }

    private async Task RunServerSearch()
    {
        var query = _searchQuery;
        if (string.IsNullOrWhiteSpace(query)) return;
        try
        {
            var results = await Http.GetFromJsonAsync<List<NoteDto>>($"api/notes/search?q={Uri.EscapeDataString(query)}") ?? new();
            // Discard the response if the user has meanwhile kept typing/cleared the search.
            if (query == _searchQuery)
            {
                _searchResults = results;
                StateHasChanged();
            }
        }
        catch
        {
            // Offline/error: the local interim result (see above) simply stays as-is.
        }
    }

    private void ScheduleSave()
    {
        _debounce?.Dispose();
        _debounce = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(SaveCurrent);
        }, null, TimeSpan.FromMilliseconds(800), Timeout.InfiniteTimeSpan);
    }

    private async Task SaveCurrent()
    {
        if (_selectedNote == null) return;
        _selectedNote.Title = _editTitle;
        _selectedNote.Content = _editContent;
        _selectedNote.CourseId = _editCourseId == 0 ? null : _editCourseId;
        _selectedNote.IsMarkdown = _editIsMarkdown;

        // Tracks what actually happened, instead of the badge unconditionally claiming
        // "saved" below regardless of the response - true only on a genuine 2xx; false on a
        // definitive rejection (e.g. a demo instance's 403 "read-only"), which must show an
        // error, not a false success; null when the request never reached the server at all
        // (offline exception) and was queued for the next sync instead - not a failure.
        bool? succeeded = null;

        // Offline (network exception): enqueue the note into AppStateService's write queue
        // (replayed on the next poll) instead of silently losing it.
        // New notes get a NEGATIVE temp id, so further offline edits/deletes of
        // the same note stay correlatable (replay strips it → POST).
        if (_selectedNote.Id == 0)
        {
            try
            {
                State.NoteOwnWrite("notes");
                var created = await Http.PostAsJsonAsync("api/notes", _selectedNote);
                succeeded = created.IsSuccessStatusCode;
                if (created.IsSuccessStatusCode)
                {
                    var dto = await created.Content.ReadFromJsonAsync<NoteDto>();
                    if (dto != null)
                    {
                        _selectedNote = dto;
                        _notes.Insert(0, dto);
                    }
                }
            }
            catch
            {
                _selectedNote.Id = -(int)(DateTime.UtcNow.Ticks / TimeSpan.TicksPerMillisecond % int.MaxValue);
                _selectedNote.CreatedAt = DateTime.Now;
                _selectedNote.UpdatedAt = DateTime.Now;
                await State.EnqueueNoteSaveAsync(_selectedNote);
                _notes.Insert(0, _selectedNote);
            }
        }
        else
        {
            State.NoteOwnWrite("notes");
            try
            {
                var response = await Http.PutAsJsonAsync($"api/notes/{_selectedNote.Id}", _selectedNote);
                succeeded = response.IsSuccessStatusCode;
            }
            catch { await State.EnqueueNoteSaveAsync(_selectedNote); }

            // Only reflect the edit in the list when it actually persisted (or is at least
            // queued to) - on a definitive rejection the list must keep showing what the
            // server actually has, not what the editor optimistically typed.
            if (succeeded != false)
            {
                var existing = _notes.FirstOrDefault(n => n.Id == _selectedNote.Id);
                if (existing != null)
                {
                    existing.Title = _selectedNote.Title;
                    existing.Content = _selectedNote.Content;
                    existing.CourseId = _selectedNote.CourseId;
                    existing.UpdatedAt = DateTime.Now;
                }
            }
        }

        _saving = succeeded == true;
        _saveFailed = succeeded == false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        _saving = false;
        _saveFailed = false;
        await InvokeAsync(StateHasChanged);
    }

    private void DeleteNote()
    {
        if (_selectedNote == null) return;

        if (_selectedNote.Id == 0)
        {
            _selectedNote = null;
            _confirmingDelete = false;
            return;
        }

        _confirmingDelete = true;
    }

    private void CancelDeleteNote()
    {
        _confirmingDelete = false;
    }

    private async Task ConfirmDeleteNote()
    {
        if (_selectedNote == null) return;
        // Offline: enqueue the delete (with a negative temp id, the queue just discards the
        // enqueued save — the server doesn't know about the note yet anyway).
        if (_selectedNote.Id < 0)
        {
            await State.EnqueueNoteDeleteAsync(_selectedNote.Id);
        }
        else
        {
            State.NoteOwnWrite("notes");
            try { await Http.DeleteAsync($"api/notes/{_selectedNote.Id}"); }
            catch { await State.EnqueueNoteDeleteAsync(_selectedNote.Id); }
        }
        _notes.RemoveAll(n => n.Id == _selectedNote.Id);
        _searchResults?.RemoveAll(n => n.Id == _selectedNote.Id);
        _selectedNote = null;
        _confirmingDelete = false;
    }

    private string FormatDate(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1) return T.JustNow;
        if (diff.TotalHours < 1) return string.Format(T.MinAgo ?? "", (int)diff.TotalMinutes);
        if (diff.TotalDays < 1) return string.Format(T.HourAgo ?? "", (int)diff.TotalHours);
        if (diff.TotalDays < 7) return string.Format(T.DayAgo ?? "", (int)diff.TotalDays);
        return dt.ToString("dd.MM.yyyy");
    }

    // Note title with an optional highlight of search matches (only with an active search).
    // The Untitled fallback is never searched/highlighted, since it isn't user content.
    private MarkupString GetHighlightedTitle(NoteDto n)
    {
        if (string.IsNullOrEmpty(n.Title))
        {
            return new MarkupString(WebUtility.HtmlEncode(T.Untitled ?? ""));
        }
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            return new MarkupString(WebUtility.HtmlEncode(n.Title));
        }
        return HighlightMatches(n.Title, _searchQuery, "", "");
    }

    // Preview excerpt of the note content. Without an active search: simply the first 80 characters
    // (as before). With an active search: the excerpt is centered around the first match, so
    // matches beyond the first 80 characters are still visible, and all matches within the
    // excerpt are highlighted.
    private MarkupString GetHighlightedPreview(NoteDto n)
    {
        const int maxLen = 80;
        var content = n.Content;
        if (string.IsNullOrWhiteSpace(content))
        {
            return new MarkupString(WebUtility.HtmlEncode(T.NoContent ?? ""));
        }

        var oneline = content.Replace('\n', ' ').Trim();
        var query = _searchQuery;

        if (string.IsNullOrWhiteSpace(query))
        {
            var plain = oneline.Length > maxLen ? oneline[..maxLen] + "…" : oneline;
            return new MarkupString(WebUtility.HtmlEncode(plain));
        }

        var matchIndex = oneline.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (matchIndex < 0 || oneline.Length <= maxLen)
        {
            var plain = oneline.Length > maxLen ? oneline[..maxLen] + "…" : oneline;
            return HighlightMatches(plain, query, "", "");
        }

        // Center the excerpt around the first match (match at roughly one third from the start).
        var start = Math.Max(0, matchIndex - maxLen / 3);
        if (start + maxLen > oneline.Length) start = Math.Max(0, oneline.Length - maxLen);
        var length = Math.Min(maxLen, oneline.Length - start);
        var excerpt = oneline.Substring(start, length);
        var prefix = start > 0 ? "…" : "";
        var suffix = start + length < oneline.Length ? "…" : "";

        return HighlightMatches(excerpt, query, prefix, suffix);
    }

    // Builds a MarkupString with <mark>-highlighted matches of `query` in `text` (substring,
    // case-insensitive). Security-critical: EVERY non-match segment (including prefix/suffix)
    // is encoded via WebUtility.HtmlEncode before going into the MarkupString - only the
    // <mark> wrapper tags themselves are raw markup. This way, note content containing &lt;, &gt;, or &
    // can neither break the markup nor be executed as HTML/script (XSS protection).
    private static MarkupString HighlightMatches(string text, string query, string prefix, string suffix)
    {
        var sb = new StringBuilder();
        sb.Append(WebUtility.HtmlEncode(prefix));

        var pos = 0;
        while (pos < text.Length)
        {
            var idx = text.IndexOf(query, pos, StringComparison.OrdinalIgnoreCase);
            if (idx < 0)
            {
                sb.Append(WebUtility.HtmlEncode(text[pos..]));
                break;
            }

            sb.Append(WebUtility.HtmlEncode(text[pos..idx]));
            sb.Append("<mark class=\"note-highlight\">");
            sb.Append(WebUtility.HtmlEncode(text.Substring(idx, query.Length)));
            sb.Append("</mark>");
            pos = idx + query.Length;
        }

        sb.Append(WebUtility.HtmlEncode(suffix));
        return new MarkupString(sb.ToString());
    }

    public void Dispose()
    {
        State.OnServerChanged -= OnServerChanged;
        _debounce?.Dispose();
        _searchDebounce?.Dispose();
    }
}

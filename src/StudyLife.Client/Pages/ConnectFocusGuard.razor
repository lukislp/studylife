@page "/connect/focusguard"
@layout PublicLayout

@* Thin wrapper: the actual consent UI/logic lives in Components/ConnectConsent.razor, shared with
   /connect/mcp and /connect/capture (see ConnectCapture.razor for the full flow writeup, identity
   contract v1 §2, generalized to the studylife-focusguard browser extension as a third audience).

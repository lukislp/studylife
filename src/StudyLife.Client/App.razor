@using StudyLife.Client.Services
@using StudyLife.Client.Models
@inject AppStateService State
@inject NavigationManager Nav
@implements IDisposable
@inject TimeProvider Clock

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private System.Threading.Timer? _watchTimer;
    private int? _lastHandledSessionId;

    protected override void OnInitialized()
    {
        _watchTimer = new System.Threading.Timer(async _ => await CheckAutoFocus(), null, 5000, 30000);
    }

    private async Task CheckAutoFocus()
    {
        try
        {
            var settings = await State.GetSettingsAsync();
            if (!settings.AutoSwitchFocus) return;

            var active = await State.GetActiveSessionAsync();
            var upcoming = active is null ? await State.GetUpcomingSessionAsync() : null;

            await InvokeAsync(() =>
            {
                var decision = AutoFocusSwitchPolicy.Decide(
                    settings, active, upcoming, Clock.LocalNow(),
                    "/" + Nav.ToBaseRelativePath(Nav.Uri), _lastHandledSessionId);
                if (decision.HandledSessionId is { } id) _lastHandledSessionId = id;
                if (decision.Navigate) Nav.NavigateTo(AutoFocusSwitchPolicy.FocusPath);
            });
        }
        catch { }
    }

    public void Dispose()
    {
        _watchTimer?.Dispose();
    }
}
<div class="dash-card card-progress">
    <div class="card-label">@Label</div>
    <div class="quota-row">
        <div class="quota-hours">
            <span class="stat-val">@EctsEarned</span>
            <span class="quota-target">/ @EctsTotal ECTS</span>
        </div>
        <div class="quota-badge badge-ok">@EctsPercent.ToString("0")%</div>
    </div>
    <div class="quota-bar-track">
        <div class="quota-bar-fill fill-ok" style="width: @EctsPercent%"></div>
    </div>
    <div class="quota-legend">
        <span>@AvgGradeWeightedLabel</span>
        <span>@AverageGradeLabel</span>
    </div>
    <div class="quota-legend">
        <span>@ForecastLabel</span>
        <span>@ForecastText</span>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int EctsEarned { get; set; }
    [Parameter] public int EctsTotal { get; set; }
    [Parameter] public double EctsPercent { get; set; }
    [Parameter] public string AvgGradeWeightedLabel { get; set; } = "";
    [Parameter] public string AverageGradeLabel { get; set; } = "";
    [Parameter] public string ForecastLabel { get; set; } = "";
    [Parameter] public string ForecastText { get; set; } = "";
}

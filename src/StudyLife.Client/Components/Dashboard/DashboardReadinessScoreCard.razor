<div class="dash-card card-readiness-score">
    <div class="card-label">@Label</div>
    <div class="quota-row">
        <div class="quota-hours">
            <span class="stat-val">@Percent.ToString("0")%</span>
            <span class="quota-target">@RatioText</span>
        </div>
        <div class="quota-badge @BadgeClass">@StatusText</div>
    </div>
    <div class="quota-bar-track">
        <div class="quota-bar-fill @FillClass" style="width: @(Math.Min(100, Percent).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public double Percent { get; set; }
    [Parameter] public string StatusText { get; set; } = "";
    [Parameter] public string RatioText { get; set; } = "";

    // Centered around the 50% "exactly your own baseline" midpoint, unlike the focus score's
    // "100% of a quota" scale - a Z-score of 0 (50%) is a perfectly normal, unremarkable day,
    // not a shortfall.
    private string BadgeClass => Percent >= 65 ? "badge-ok" : Percent >= 35 ? "badge-warn" : "badge-bad";
    private string FillClass => Percent >= 65 ? "fill-ok" : Percent >= 35 ? "fill-warn" : "fill-bad";
}

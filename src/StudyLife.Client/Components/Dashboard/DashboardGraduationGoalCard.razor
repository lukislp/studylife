<div class="dash-card card-graduation-goal @(!Expired && !OnTrack ? "quota-warn" : "")">
    <div class="card-label">@Label</div>
    @if (Expired)
    {
        <div class="empty-state">@ExpiredText</div>
        <div class="quota-legend">
            <span>@TargetText</span>
        </div>
    }
    else
    {
        <div class="quota-row">
            <div class="quota-hours">
                <span class="stat-val">@RequiredValue</span>
                <span class="quota-target">@RequiredSuffix</span>
            </div>
            <div class="quota-badge @(OnTrack ? "badge-ok" : "badge-warn")">
                @(OnTrack ? OnTrackText : BehindText)
            </div>
        </div>
        <div class="quota-legend">
            <span>@TargetText</span>
            <span>@PaceText</span>
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    /// <summary>Required study hours per week, already formatted (one decimal place, comma).</summary>
    [Parameter] public string RequiredValue { get; set; } = "";
    [Parameter] public string RequiredSuffix { get; set; } = "";
    /// <summary>Formatted "Target: {date}" line.</summary>
    [Parameter] public string TargetText { get; set; } = "";
    /// <summary>Formatted "Current pace: {0} h/week" line.</summary>
    [Parameter] public string PaceText { get; set; } = "";
    [Parameter] public bool OnTrack { get; set; }
    [Parameter] public string OnTrackText { get; set; } = "";
    [Parameter] public string BehindText { get; set; } = "";
    /// <summary>Target date is in the past — required hours can no longer be computed.</summary>
    [Parameter] public bool Expired { get; set; }
    [Parameter] public string ExpiredText { get; set; } = "";
}

@using StudyLife.Client.I18nText
@inject Toolbelt.Blazor.I18nText.I18nText I18nText
@inject HttpClient Http

@* The privacy policy link for pages shown before sign-in (sign-in, registration): the policy has to
   be reachable without an account (App Store guideline 5.1.1(i)). Same address and text as the
   About section in Setup (LegalLinks, AboutText). The imprint sits next to it, and an
   operator's own policy (Legal:PrivacyUrl) is shown as well when the server has one. *@

@if (T is not null)
{
    <p class="ss-desc privacy-policy-note" style="margin-top:1rem; font-size:0.8rem;">
        <LegalLinkAnchors Links="_links" Texts="T" />
    </p>
}

@code {
    private AboutText? T;
    private LegalLinks? _links;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<AboutText>(this);
        var language = await I18nText.GetCurrentLanguageAsync();
        _links = LegalLinks.Publisher(language);
        _links = await new LegalLinksSource(Http).LoadAsync(language);
    }
}

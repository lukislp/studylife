@using StudyLife.Shared
<div class="setup-section">
    <div class="ss-label">@Label</div>
    <div class="rhythm-subtitle">@Subtitle</div>
    <div class="mini-bar-chart inactivity-chart">
        @foreach (var w in Weeks)
        {
            <div class="mini-bar-col" title="@($"{w.Label}: {w.HoursLabel}")">
                <div class="mini-bar-track">
                    <div class="mini-bar-fill" style="height: @w.Percent%"></div>
                </div>
                <div class="mini-bar-label">@w.Label</div>
            </div>
        }
    </div>
</div>

@code {
    public record WeekBar(string Label, double Hours, double Percent)
    {
        public string HoursLabel => StudyMetrics.FormatHoursMinutes(Hours);
    }

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public List<WeekBar> Weeks { get; set; } = new();
}

<div class="timer-controls">
    <button class="btn-timer btn-reset" aria-label="@ResetTitle" @onclick="() => OnReset.InvokeAsync()" title="@ResetTitle">↺</button>
    <button class="btn-timer btn-playpause @(IsRunning ? "running" : "")" aria-label="@(IsRunning ? PauseLabel : PlayLabel)" @onclick="() => OnToggle.InvokeAsync()">
        @(IsRunning ? "⏸" : "▶")
    </button>
    <button class="btn-timer btn-skip" aria-label="@SkipTitle" @onclick="() => OnNext.InvokeAsync()" title="@SkipTitle">⇄</button>
</div>

@code {
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public string ResetTitle { get; set; } = "";
    [Parameter] public string SkipTitle { get; set; } = "";
    [Parameter] public string PlayLabel { get; set; } = "";
    [Parameter] public string PauseLabel { get; set; } = "";
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}

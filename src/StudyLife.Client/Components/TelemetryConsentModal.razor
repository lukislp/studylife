@using StudyLife.Client.Services
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Shown once from MainLayout after settings are first loaded, when TelemetryConsent is still
   null (docs/ARCHITECTURE.md "Telemetry", phase 2) - never again afterward, on either answer.
   Deliberately no backdrop-click-to-dismiss and no close button (unlike every other modal in
   this app): a consent prompt needs an explicit choice, not an implicit dismiss that would leave
   the setting undecided and the modal reappearing on the next load. It must still never trap the
   user: when the answer cannot be saved (offline, server error) the dialog says so and offers
   "later" (closes for this start, nothing recorded, asked again on the next start); a server
   without the endpoint (older than 3.38.0) closes it right away. *@

@if (Show)
{
    <div class="modal-overlay">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="telemetry-consent-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 id="telemetry-consent-title">@T.Heading</h3>
            </div>
            <div class="modal-body">
                <p class="ss-desc">@T.ExplainWhatText</p>
                <p class="ss-desc">@T.ExplainChangeText</p>
                @if (_saveFailed)
                {
                    <p class="ss-desc" role="alert" data-testid="telemetry-consent-error">@T.ErrorText</p>
                }
            </div>
            <div class="modal-footer">
                @if (_saveFailed)
                {
                    <button type="button" class="btn-secondary" @onclick="LaterAsync" disabled="@_busy" data-testid="telemetry-consent-later">
                        @T.LaterButton
                    </button>
                }
                <button type="button" class="btn-secondary" @onclick="() => AnswerAsync(false)" disabled="@_busy">
                    @T.DeclineButton
                </button>
                <button type="button" class="btn-primary" @onclick="() => AnswerAsync(true)" disabled="@_busy">
                    @T.AcceptButton
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnAnswered { get; set; }

    private I18nText.TelemetryConsentModalText T = new();
    private bool _busy;
    private bool _saveFailed;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<I18nText.TelemetryConsentModalText>(this);
    }

    private async Task AnswerAsync(bool consent)
    {
        _busy = true;
        StateHasChanged();
        try
        {
            // A recorded answer closes the dialog. A server without the endpoint cannot record
            // anything, ever: close as well. Any other failure keeps the question on screen with an
            // error and a way out (LaterAsync) instead of looking answered while nothing was saved.
            switch (await State.TrySetTelemetryConsentAsync(consent))
            {
                case TelemetryConsentSaveResult.Saved:
                case TelemetryConsentSaveResult.Unavailable:
                    _saveFailed = false;
                    await OnAnswered.InvokeAsync();
                    break;
                default:
                    _saveFailed = true;
                    break;
            }
        }
        finally { _busy = false; }
    }

    /// <summary>Closes for this start without recording a decision; the question comes back next start.</summary>
    private async Task LaterAsync()
    {
        _saveFailed = false;
        await OnAnswered.InvokeAsync();
    }
}

@using StudyLife.Client.Services
@using Microsoft.Extensions.DependencyInjection
@inject HttpClient Http
@inject NavigationManager Nav
@inject SessionTokenStore TokenStore
@inject IServiceProvider Services

@* Username + password sign-in under the passkey button of the sign-in page (Login.razor). Renders
   nothing unless the installation offers it (GET api/auth/methods, the operator switch
   PasswordSignIn:Enabled), so a server with passwords switched off - or an older server - shows
   the passkey page exactly as before. A real <form> with name/autocomplete="username" and
   "current-password", so browsers, iCloud Keychain, Google Password Manager and other password
   managers recognise, fill and save it. The password never leaves this component except in the
   one sign-in request; only the returned session token is kept (SessionTokenStore), exactly like
   after a passkey sign-in. Inside the native app's system-browser flow (?app=1) the token goes
   back through the same PKCE handoff as the passkey path. *@

@if (T is not null && _offered)
{
    <div aria-hidden="true" style="display:flex; align-items:center; gap:0.75rem; color:var(--text3); font-size:0.85rem;">
        <span style="flex:1; height:1px; background:var(--border);"></span>
        <span>@T.LoginOr</span>
        <span style="flex:1; height:1px; background:var(--border);"></span>
    </div>
    <form @onsubmit="SignInAsync" aria-labelledby="password-signin-heading"
          style="display:flex; flex-direction:column; gap:0.5rem;">
        <h2 id="password-signin-heading" class="ss-label" style="margin:0; font-size:0.95rem;">@T.LoginPasswordHeading</h2>
        <label class="ss-desc" for="signin-username" style="margin:0">@T.UsernameLabel</label>
        <input id="signin-username" name="username" class="input" type="text" autocomplete="username"
               autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="256"
               @bind="_username" @bind:event="oninput" disabled="@_busy" />
        <label class="ss-desc" for="signin-password" style="margin:0">@T.PasswordLabel</label>
        <input id="signin-password" name="password" class="input" type="@(_show ? "text" : "password")"
               autocomplete="current-password" maxlength="512"
               @bind="_password" @bind:event="oninput" disabled="@_busy" />
        <label class="toggle-row" style="gap:0.5rem; font-size:0.85rem;">
            <input type="checkbox" @bind="_show" disabled="@_busy" />
            <span>@T.ShowPassword</span>
        </label>
        @if (_error is not null)
        {
            <p class="ss-desc" role="alert" style="color:var(--danger, #e74c3c); margin:0">@_error</p>
        }
        <button type="submit" class="btn-secondary"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))">
            @(_busy ? T.Working : T.LoginPasswordButton)
        </button>
    </form>
}

@code {
    /// <summary>The page's native-app return context (?app=1): the token then goes back to the app.</summary>
    [Parameter] public AppReturnContext? App { get; set; }

    /// <summary>Validated same-origin path to continue to after signing in (Login.razor checks it).</summary>
    [Parameter] public string? ReturnUrl { get; set; }

    /// <summary>Texts for component tests; the app loads the table for the current language.</summary>
    [Parameter] public StudyLife.Client.I18nText.PasswordText? Text { get; set; }

    private StudyLife.Client.I18nText.PasswordText? T;
    private bool _offered;
    private bool _busy;
    private bool _show;
    private string _username = "";
    private string _password = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        T = Text ?? await Services.GetRequiredService<Toolbelt.Blazor.I18nText.I18nText>()
            .GetTextTableAsync<StudyLife.Client.I18nText.PasswordText>(this);
        _offered = await new PasswordSignInState(Http).IsOfferedAsync();
    }

    private async Task SignInAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password)) return;
        _busy = true;
        _error = null;
        try
        {
            var attempt = await new PasswordSignInState(Http).SignInAsync(_username, _password);
            if (!attempt.Succeeded)
            {
                _error = PasswordSignInState.Message(attempt.Failure, T!);
                _password = "";
                return;
            }
            _password = "";

            if (App is { IsActive: true })
            {
                Nav.NavigateTo(await App.BuildTokenReturnRedirectAsync(Http, attempt.Token!), forceLoad: true);
                return;
            }
            await TokenStore.SetTokenAsync(attempt.Token!);
            // forceLoad like every sign-in path: a full restart so no cached data of another account
            // survives. A temporary password from the owner goes straight to the card to replace it.
            Nav.NavigateTo(attempt.ChangeRequired ? "/setup#password" : ReturnUrl ?? "/", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}

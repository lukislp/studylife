@using StudyLife.Client.Services
@using StudyLife.Shared

<div class="cal-session cal-session-ghost @(Layout.Compact ? "cal-session-compact" : "")" title="@Proposal.CourseName · @LocalDate.Time(Proposal.Start)–@LocalDate.Time(Proposal.End)" style="top:@(Layout.Top)px;height:@(Layout.Height.ToString(System.Globalization.CultureInfo.InvariantCulture))px;--c:@Proposal.CourseColor"
     @onclick:stopPropagation="true">
    @if (Layout.Compact)
    {
        <div class="cs-name">@Proposal.CourseName · @LocalDate.Time(Proposal.Start)–@LocalDate.Time(Proposal.End)</div>
    }
    else
    {
        <div class="cs-name">@Proposal.CourseName</div>
        @if (!string.IsNullOrEmpty(Proposal.Topic))
        {
            <div class="cs-topic">@Proposal.Topic</div>
        }
        <div class="cs-time">@LocalDate.Time(Proposal.Start)–@LocalDate.Time(Proposal.End)</div>
    }
    <div class="cs-ghost-actions">
        <button type="button" class="cs-ghost-btn cs-ghost-confirm" title="@ConfirmTitle" aria-label="@ConfirmTitle"
                @onclick="() => OnConfirm.InvokeAsync()">✓</button>
        <button type="button" class="cs-ghost-btn cs-ghost-remove" title="@RemoveTitle" aria-label="@RemoveTitle"
                @onclick="() => OnRemove.InvokeAsync()">✕</button>
    </div>
</div>

@code {
    [Parameter] public PlanProposal Proposal { get; set; } = new();
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public string? ConfirmTitle { get; set; }
    [Parameter] public string? RemoveTitle { get; set; }

    /// <summary>A proposal is always in the future, so only the geometry matters. The block carries
    /// the confirm/remove buttons (14 px tall in compact blocks), hence the larger minimum height.</summary>
    private SessionBlockLayout Layout => SessionBlockLayout.Compute(
        Proposal.Start, Proposal.End, false, DateTime.MinValue, GhostMinHeightPx);

    private const double GhostMinHeightPx = 16;
}

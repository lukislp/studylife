@using StudyLife.Client.Models

<div class="cal-day @(IsToday ? "today" : "") @(IsPast ? "past" : "")">
    <div class="day-body" @onclick="(e) => OnDayClick.InvokeAsync(e)" style="position:relative;height:1440px;cursor:pointer">
        @if (IsToday)
        {
            var nowTop = DateTime.Now.Hour * 60 + DateTime.Now.Minute;
            if (nowTop >= 0 && nowTop <= 1440)
            {
                <div class="cal-now-line" style="top:@(nowTop)px"></div>
            }
        }
        @foreach (var session in Sessions)
        {
            var s = session;
            <CalendarSessionBlock Session="s" OnClick="@(() => OnSessionClick.InvokeAsync(s))" />
        }
        @GhostContent
    </div>
</div>

@code {
    [Parameter] public DateTime Date { get; set; }
    [Parameter] public List<StudySession> Sessions { get; set; } = new();
    [Parameter] public EventCallback<MouseEventArgs> OnDayClick { get; set; }
    [Parameter] public EventCallback<StudySession> OnSessionClick { get; set; }
    /// <summary>Extra content absolutely-positioned into the same 1440px-tall day-body as the real
    /// session blocks above - used by PlannerCalendarPreview.razor to overlay not-yet-created
    /// proposed sessions without duplicating this component's real-session rendering.</summary>
    [Parameter] public RenderFragment? GhostContent { get; set; }

    private bool IsToday => Date.Date == DateTime.Today;
    private bool IsPast => Date.Date < DateTime.Today;
}

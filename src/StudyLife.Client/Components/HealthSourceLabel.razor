@using StudyLife.Client.I18nText
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Source caption for everything that shows Apple Health data (dashboard readiness/sleep tiles,
   the cardio fitness trend, the movement nudge). Those spots only render in the native iOS app
   (INativeHealthData.IsAvailable), so this component carries no platform check of its own.
   The heart is a plain inline glyph, not Apple's Health app icon. The name is the Settings
   heading (HealthHeading), so it matches the localized product name there. *@

@if (T is not null)
{
    <div class="health-source">
        <svg class="health-source-icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>@T.HealthHeading</span>
    </div>
}

@code {
    private NativeAppSettingsText? T;

    protected override async Task OnInitializedAsync() =>
        T = await I18nText.GetTextTableAsync<NativeAppSettingsText>(this);
}

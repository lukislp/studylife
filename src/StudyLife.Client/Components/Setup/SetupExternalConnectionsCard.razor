@using StudyLife.Shared
@inject HttpClient Http
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Consolidated status/disconnect card for the five integrations that no longer provision a key
   through this Setup page: studylife-mcp (AuthUserEntity.McpApiKeyHash), studylife-capture
   (CaptureApiKeyHash), studylife-focusguard (FocusGuardApiKeyHash), studylife-timetrack
   (TimeTrackApiKeyHash), and studylife-focustunes (FocusTunesApiKeyHash). UNLIKE the Home
   Assistant and studylife-ai cards, this one never generates a key here - provisioning happens
   exclusively through each integration's own consent flow (each extension's own "Connect" action
   against its already-authenticated session; the MCP OAuth connect flow behind
   AuthController.McpConnect, plus the CLI login, for stdio-based MCP clients). The only thing a
   user ever needs from THIS page for any of the five is an emergency disconnect, so the card is
   reduced to a status line plus a revoke button per slot - no generate, no one-time plaintext
   reveal, no advanced disclosure, no manual paste path. Self-contained component (own SetupText
   instance + own HTTP calls), reusing the existing per-slot status and revoke endpoints
   (SettingsController) completely unchanged - this is a client-only UI simplification. *@

<div class="setup-section">
    <div class="ss-label">@T.ExternalConnectionsHeading</div>
    <p class="ss-desc">@T.ExternalConnectionsDesc</p>

    <div class="toggle-row" style="justify-content:space-between;flex-wrap:wrap">
        <span>@T.McpConnectionLabel — <strong>@(_mcpConnected ? T.ConnectionConnected : T.ConnectionNotConnected)</strong></span>
        @if (_mcpConnected)
        {
            <button type="button" class="btn-danger" @onclick="DisconnectMcp" disabled="@_mcpBusy">
                @(_mcpBusy ? "…" : T.DisconnectButton)
            </button>
        }
    </div>

    <div class="toggle-row" style="justify-content:space-between;flex-wrap:wrap">
        <span>@T.CaptureConnectionLabel — <strong>@(_captureConnected ? T.ConnectionConnected : T.ConnectionNotConnected)</strong></span>
        @if (_captureConnected)
        {
            <button type="button" class="btn-danger" @onclick="DisconnectCapture" disabled="@_captureBusy">
                @(_captureBusy ? "…" : T.DisconnectButton)
            </button>
        }
    </div>

    <div class="toggle-row" style="justify-content:space-between;flex-wrap:wrap">
        <span>@T.FocusGuardConnectionLabel — <strong>@(_focusGuardConnected ? T.ConnectionConnected : T.ConnectionNotConnected)</strong></span>
        @if (_focusGuardConnected)
        {
            <button type="button" class="btn-danger" @onclick="DisconnectFocusGuard" disabled="@_focusGuardBusy">
                @(_focusGuardBusy ? "…" : T.DisconnectButton)
            </button>
        }
    </div>

    <div class="toggle-row" style="justify-content:space-between;flex-wrap:wrap">
        <span>@T.TimeTrackConnectionLabel — <strong>@(_timeTrackConnected ? T.ConnectionConnected : T.ConnectionNotConnected)</strong></span>
        @if (_timeTrackConnected)
        {
            <button type="button" class="btn-danger" @onclick="DisconnectTimeTrack" disabled="@_timeTrackBusy">
                @(_timeTrackBusy ? "…" : T.DisconnectButton)
            </button>
        }
    </div>

    <div class="toggle-row" style="justify-content:space-between;flex-wrap:wrap">
        <span>@T.FocusTunesConnectionLabel — <strong>@(_focusTunesConnected ? T.ConnectionConnected : T.ConnectionNotConnected)</strong></span>
        @if (_focusTunesConnected)
        {
            <button type="button" class="btn-danger" @onclick="DisconnectFocusTunes" disabled="@_focusTunesBusy">
                @(_focusTunesBusy ? "…" : T.DisconnectButton)
            </button>
        }
    </div>
</div>

@code {
    private I18nText.SetupText T = new();

    private bool _mcpConnected;
    private bool _captureConnected;
    private bool _focusGuardConnected;
    private bool _timeTrackConnected;
    private bool _focusTunesConnected;
    private bool _mcpBusy;
    private bool _captureBusy;
    private bool _focusGuardBusy;
    private bool _timeTrackBusy;
    private bool _focusTunesBusy;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        try
        {
            var mcpStatus = await Http.GetFromJsonAsync<McpApiKeyStatusDto>("api/settings/mcp-api-key");
            _mcpConnected = mcpStatus?.HasKey ?? false;
        }
        catch { /* offline: card shows the "not connected" default */ }
        try
        {
            var captureStatus = await Http.GetFromJsonAsync<CaptureApiKeyStatusDto>("api/settings/capture-api-key");
            _captureConnected = captureStatus?.HasKey ?? false;
        }
        catch { /* offline: card shows the "not connected" default */ }
        try
        {
            var focusGuardStatus = await Http.GetFromJsonAsync<FocusGuardApiKeyStatusDto>("api/settings/focusguard-api-key");
            _focusGuardConnected = focusGuardStatus?.HasKey ?? false;
        }
        catch { /* offline: card shows the "not connected" default */ }
        try
        {
            var timeTrackStatus = await Http.GetFromJsonAsync<TimeTrackApiKeyStatusDto>("api/settings/timetrack-api-key");
            _timeTrackConnected = timeTrackStatus?.HasKey ?? false;
        }
        catch { /* offline: card shows the "not connected" default */ }
        try
        {
            var focusTunesStatus = await Http.GetFromJsonAsync<FocusTunesApiKeyStatusDto>("api/settings/focustunes-api-key");
            _focusTunesConnected = focusTunesStatus?.HasKey ?? false;
        }
        catch { /* offline: card shows the "not connected" default */ }
    }

    private async Task DisconnectMcp()
    {
        _mcpBusy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/mcp-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _mcpConnected = false;
        }
        finally { _mcpBusy = false; }
    }

    private async Task DisconnectCapture()
    {
        _captureBusy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/capture-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _captureConnected = false;
        }
        finally { _captureBusy = false; }
    }

    private async Task DisconnectFocusGuard()
    {
        _focusGuardBusy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/focusguard-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _focusGuardConnected = false;
        }
        finally { _focusGuardBusy = false; }
    }

    private async Task DisconnectTimeTrack()
    {
        _timeTrackBusy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/timetrack-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _timeTrackConnected = false;
        }
        finally { _timeTrackBusy = false; }
    }

    private async Task DisconnectFocusTunes()
    {
        _focusTunesBusy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/focustunes-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _focusTunesConnected = false;
        }
        finally { _focusTunesBusy = false; }
    }
}

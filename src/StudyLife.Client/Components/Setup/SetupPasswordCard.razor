@using StudyLife.Shared
@using StudyLife.Client.Services
@using Microsoft.Extensions.DependencyInjection
@inject AppStateService State
@inject IServiceProvider Services

@* Username + password as an ADDITIONAL sign-in method (docs/ARCHITECTURE.md "Password sign-in").
   Accounts from before the feature have none; here they can add one ("Passwort hinzufügen"),
   change it or remove it. Nobody can reset another account's password, the owner included: a user
   who forgot theirs signs in with a passkey or a recovery code (Login > "Forgot your password?") and
   lands here with the change form open (StartChange); that fresh sign-in is the proof.
   Every rule (length, common passwords, last method, proof) is decided by the server; this
   component renders State.PasswordSignIn's answers and runs the passkey prompt for the proof.
   Passkeys stay the recommended method, and the copy says so.

   WCAG 2.2: the inline form is a labelled group, every input has a visible label and the right
   autocomplete token (username / new-password / current-password) so browsers and the OS password
   managers can fill and save it, errors are announced (role="alert"), results are role="status". *@

@if (T is not null && _status is { } status && (status.Enabled || status.HasPassword))
{
<div class="setup-section" id="password">
    <div class="ss-label">@T.CardHeading</div>
    @{
        <p class="ss-desc">@T.CardIntro</p>

        @if (!status.Enabled)
        {
            <p class="ss-desc">@T.CardDisabled</p>
        }
        else if (_freshStart && _mode == Mode.Change)
        {
            <p class="ss-desc" role="status">@T.ForgotCardHint</p>
        }

        @if (status.HasPassword)
        {
            <p class="ss-desc">@string.Format(T.CardUsernameFormat ?? "", status.Username)</p>
            @if (status.UpdatedAt is { } updated)
            {
                <p class="ss-desc">@string.Format(T.CardUpdatedFormat ?? "", LocalDate.Short(updated.ToLocalTime()))</p>
            }
        }
        else
        {
            <p class="ss-desc">@T.CardNoPassword</p>
        }

        @if (_info is not null)
        {
            <p class="ss-desc" role="status">@_info</p>
        }

        @if (_mode == Mode.None)
        {
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                @if (status.Enabled && !status.HasPassword)
                {
                    <button type="button" class="btn-secondary" @onclick="() => Open(Mode.Add)">@T.AddButton</button>
                }
                @if (status.Enabled && status.HasPassword)
                {
                    <button type="button" class="btn-secondary" @onclick="() => Open(Mode.Change)">@T.ChangeButton</button>
                }
                @if (status.HasPassword)
                {
                    <button type="button" class="btn-danger" @onclick="() => Open(Mode.Remove)" disabled="@(!status.CanRemove)"
                            aria-describedby="@(status.CanRemove ? null : "password-remove-hint")">@T.RemoveButton</button>
                }
            </div>
            @if (status.HasPassword && !status.CanRemove)
            {
                <p class="ss-desc" id="password-remove-hint" style="font-size:0.8rem">@T.RemoveBlockedHint</p>
            }
        }
        else
        {
            <form class="setup-section" role="group" aria-labelledby="password-form-title" @onsubmit="() => { }" @onsubmit:preventDefault
                  style="display:flex; flex-direction:column; gap:0.5rem; margin-top:0.5rem;">
                <div class="ss-label" id="password-form-title">@FormTitle</div>

                @if (_mode == Mode.Remove)
                {
                    <p class="ss-desc">@T.RemoveConfirm</p>
                }

                @if (NeedsUsername)
                {
                    <label class="ss-desc" for="password-username">@T.UsernameLabel</label>
                    <input id="password-username" name="username" class="input" type="text" autocomplete="username"
                           autocapitalize="none" spellcheck="false" maxlength="64" aria-describedby="password-username-hint"
                           @bind="_username" @bind:event="oninput" disabled="@_busy" />
                    <p class="ss-desc" id="password-username-hint" style="font-size:0.8rem; margin-top:0">@T.UsernameHint</p>
                }
                else if (_mode is Mode.Change && status.Username is { } name)
                {
                    @* The login name is fixed while a password exists (server rule). Shown read-only,
                       which also lets password managers attach the new password to the right account. *@
                    <label class="ss-desc" for="password-username">@T.UsernameLabel</label>
                    <input id="password-username" name="username" class="input" type="text" autocomplete="username"
                           value="@name" readonly aria-describedby="password-username-fixed-hint" />
                    <p class="ss-desc" id="password-username-fixed-hint" style="font-size:0.8rem; margin-top:0">@T.UsernameFixedHint</p>
                }

                @if (_mode is Mode.Add or Mode.Change)
                {
                    <label class="ss-desc" for="password-new">@T.NewPasswordLabel</label>
                    <input id="password-new" name="new-password" class="input" type="@(_show ? "text" : "password")"
                           autocomplete="new-password" maxlength="512" aria-describedby="password-new-hint"
                           @bind="_newPassword" @bind:event="oninput" disabled="@_busy" />
                    <p class="ss-desc" id="password-new-hint" style="font-size:0.8rem; margin-top:0">@T.PasswordHint</p>
                    <label class="toggle-row" style="gap:0.5rem">
                        <input type="checkbox" @bind="_show" disabled="@_busy" />
                        <span>@T.ShowPassword</span>
                    </label>
                }

                @if (_freshStart && _mode == Mode.Change)
                {
                    @* Just signed in with a passkey or recovery code: that sign-in is the proof (server:
                       VerifyFreshProofAsync accepts a session younger than two minutes), so no second
                       confirmation. If the window ran out the picker below takes over. *@
                    @if (_error is not null)
                    {
                        <p class="ss-desc" role="alert" style="color:var(--danger, #e74c3c)">@_error</p>
                    }
                    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                        <button type="button" class="btn-primary" @onclick="() => RunAsync(new PasswordProof(), freshSignIn: true)"
                                disabled="@(_busy || !FormReady)">@(_busy ? T.Working : T.SaveButton)</button>
                        <button type="button" class="btn-secondary" @onclick="Close" disabled="@_busy">@T.CancelButton</button>
                    </div>
                }
                else
                {
                <div class="ss-label">@T.ConfirmHeading</div>
                <FreshProofPicker Labels="_labels" HasPasskey="status.HasPasskey" HasPassword="status.HasPassword && status.Enabled"
                                  Busy="_busy" Disabled="!FormReady" Error="@_error"
                                  PrimaryClass="@(_mode == Mode.Remove ? "btn-danger" : "btn-primary")"
                                  PasswordInputId="password-current" RecoveryInputId="password-recovery"
                                  OnProof="RunWithProofAsync" OnCeremonyFailed="OnCeremonyFailed">
                    <Secondary>
                        <button type="button" class="btn-secondary" @onclick="Close" disabled="@_busy">@T.CancelButton</button>
                    </Secondary>
                </FreshProofPicker>
                }
            </form>
        }

    }
</div>
}

@code {
    /// <summary>Texts to render with. Left null in the app (loaded from the i18n table for the
    /// current language); component tests pass them in directly.</summary>
    [Parameter] public StudyLife.Client.I18nText.PasswordText? Text { get; set; }

    /// <summary>Open the change form right away: the visitor came from "Forgot your password?" on
    /// the sign-in page and just signed in with a passkey or recovery code, which is the proof.</summary>
    [Parameter] public bool StartChange { get; set; }

    private enum Mode { None, Add, Change, Remove }

    private StudyLife.Client.I18nText.PasswordText? T;
    private PasswordStatusDto? _status;
    private Mode _mode;
    private string _username = "";
    private string _newPassword = "";
    private bool _show;
    private bool _busy;
    private bool _freshStart;
    private string? _error;
    private string? _info;

    private string? FormTitle => _mode switch
    {
        Mode.Add => T!.AddButton,
        Mode.Change => T!.ChangeButton,
        _ => T!.RemoveButton,
    };

    private bool NeedsUsername => _mode == Mode.Add;

    // The new password (and name) must be filled in before a proof is asked for: a browser sign-in
    // would otherwise leave the app for nothing.
    private bool FormReady => _mode switch
    {
        Mode.Add => !string.IsNullOrWhiteSpace(_username) && _newPassword.Length > 0,
        Mode.Change => _newPassword.Length > 0,
        _ => true,
    };

    protected override async Task OnInitializedAsync()
    {
        T = Text ?? await Services.GetRequiredService<Toolbelt.Blazor.I18nText.I18nText>()
            .GetTextTableAsync<StudyLife.Client.I18nText.PasswordText>(this);
        await LoadAsync();
        if (StartChange && _status is { Enabled: true, HasPassword: true })
        {
            Open(Mode.Change);
            _freshStart = true;
        }
    }

    protected override void OnParametersSet()
    {
        if (Text is not null) T = Text;
    }

    private async Task LoadAsync() => _status = await State.PasswordSignIn.GetStatusAsync();

    private void Open(Mode mode)
    {
        _mode = mode;
        _freshStart = false;
        _error = null;
        _info = null;
        _username = "";
        _newPassword = "";
        _show = false;
    }

    private void Close()
    {
        if (_busy) return;
        _mode = Mode.None;
        _newPassword = "";
    }

    private FreshProofLabels _labels
    {
        get
        {
            var action = _mode == Mode.Remove ? T!.RemoveButton : T!.SaveButton;
            return new(T.ConfirmHint, T.BrowserSignInHint, T.ConfirmWithPasskey, T.BrowserSignInButton,
                T.PasswordToggle, T.CurrentPasswordLabel, action, T.RecoveryToggle, T.RecoveryCodeLabel, action,
                T.Working, T.ErrorProofRejected);
        }
    }

    private void OnCeremonyFailed(string message) => _error = message;

    private Task RunWithProofAsync(FreshProof proof) =>
        RunAsync(new PasswordProof(proof.CurrentPassword, proof.RecoveryCode, proof.OptionsId, proof.AssertionJson), proof.IsFreshSession);

    private async Task RunAsync(PasswordProof proof, bool freshSignIn = false)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var mode = _mode;
            var attempt = mode switch
            {
                Mode.Add => await State.PasswordSignIn.SetAsync(_username, _newPassword, proof),
                Mode.Change => await State.PasswordSignIn.SetAsync(null, _newPassword, proof),
                _ => await State.PasswordSignIn.RemoveAsync(proof),
            };
            if (!attempt.Succeeded)
            {
                // After a browser sign-in the sign-in itself was the proof; if the server still wants
                // one, the two-minute window ran out (a slow sign-in) - say so instead of a generic hint.
                if (freshSignIn && attempt.Failure == PasswordFailure.ProofRequired) _freshStart = false;
                _error = freshSignIn && attempt.Failure == PasswordFailure.ProofRequired
                    ? T!.ErrorFreshSignInExpired
                    : PasswordSignInState.Message(attempt.Failure, T!);
                return;
            }

            _mode = Mode.None;
            _freshStart = false;
            _newPassword = "";
            await LoadAsync();
            _info = mode switch
            {
                Mode.Add => string.Format(T!.AddedInfo ?? "", _status?.Username),
                Mode.Change => T!.ChangedInfo,
                Mode.Remove => T!.RemovedInfo,
                _ => null,
            };
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
}

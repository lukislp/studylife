    [Parameter] public EventCallback<bool> NewRecordNotificationsEnabledChanged { get; set; }

    [Parameter] public string MonthlyReportLabel { get; set; } = "";
    [Parameter] public bool MonthlyReportEnabled { get; set; }
    [Parameter] public EventCallback<bool> MonthlyReportEnabledChanged { get; set; }
}

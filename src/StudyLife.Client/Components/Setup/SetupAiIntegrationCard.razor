@using StudyLife.Shared
@using StudyLife.Client.Services
@inject HttpClient Http
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived per-user API key for the studylife-ai integration - a SEPARATE slot from the
   Home Assistant key (AuthUserEntity.AiApiKeyHash vs ApiKeyHash, see SettingsController's
   ai-api-key group). UNLIKE the Home Assistant/MCP/Capture cards, this is a plain on/off
   toggle, not a reveal-once-plaintext lifecycle: nothing external ever needs the raw key -
   the server hands it to studylife-ai itself at generation time (AiProxyClient.
   RegisterKeyAsync via the AI key outbox) and only ever stores the SHA-256 hash locally, so
   the user has nothing to copy or paste anywhere. Same discard-immediately pattern as
   AgentChatModal's ActivateAsync: call generate, ignore the plaintext in the response.
   Deliberately no rotation warning/confirmation on "Reconnect" either - regenerating doesn't
   break anything the user configured by hand, it just asks the server to mint+register a
   fresh key, so it's framed as a lightweight recovery action, not a destructive one. Self-
   contained component (own SetupText instance + own HTTP calls), modeled after
   SetupProgressShareCard's enable/disable/regenerate-with-success-flash shape.

   AI consent (Apple App Review guideline 5.1.2(i)): the card decides nothing. Enable/Reconnect
   first ask State.AiConsent ("ensure consent, then continue"); the card is hidden when the
   installation has no AI add-on (AiAvailable false, which the server also reports on demo
   instances); it says once that a local-only add-on runs on the operator's own server, and shows
   when consent was given with a "withdraw" action that also switches AI off and deletes the
   user's indexed data. The rule lives in AiConsentService, the dialog in AiConsentModal. *@

@if (_consent is { AiAvailable: true })
{
<div class="setup-section">
    <div class="ss-label">@T.AiIntegrationHeading</div>
    <p class="ss-desc">@T.AiIntegrationDesc</p>
    @if (_consent is { ConsentRequired: false, ProviderKnown: true })
    {
        <p class="ss-desc">@TC.LocalRunsHere</p>
    }
    @if (_consent is { ConsentRequired: true, Granted: true, GrantedAt: { } grantedAt })
    {
        <p class="ss-desc">
            @string.Format(TC.ConsentGivenOn ?? "{0}", LocalDate.DateAndTime(grantedAt.ToLocalTime()))
        </p>
        <button type="button" class="btn-danger" @onclick="() => _confirmingWithdraw = true" disabled="@_busy">
            @TC.WithdrawButton
        </button>
    }

    @if (_hasKey)
    {
        <p class="ss-desc" style="font-weight:600">
            ✅ @T.Enabled — @string.Format(T.AiKeyActiveSince ?? "", _createdAt is { } created ? LocalDate.DateAndTime(created.ToLocalTime()) : "")
        </p>
        <div class="toggle-row" style="gap:0.75rem;flex-wrap:wrap">
            <button type="button" class="btn-secondary" @onclick="Reconnect" disabled="@_busy">
                @(_reconnectSuccess ? $"✓ {T.AiKeyReconnectSuccess}" : (_reconnecting ? "…" : T.AiKeyReconnectButton))
            </button>
            <button type="button" class="btn-danger" @onclick="() => _confirmingDisable = true" disabled="@_busy">
                @T.AiKeyDisableButton
            </button>
        </div>
    }
    else
    {
        <p class="ss-desc">@T.Disabled</p>
        <button type="button" class="btn-secondary" @onclick="Enable" disabled="@_busy">
            @(_busy ? "…" : T.AiKeyEnableButton)
        </button>
    }
</div>
}

@if (_confirmingWithdraw)
{
    <div class="modal-overlay" @onclick="() => _confirmingWithdraw = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ai-consent-withdraw-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 id="ai-consent-withdraw-title">@TC.WithdrawButton</h3>
                <button type="button" class="modal-close" aria-label="@T.AriaCloseDialog" @onclick="() => _confirmingWithdraw = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @TC.WithdrawConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingWithdraw = false" disabled="@_busy">
                    @T.AiKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmWithdraw" disabled="@_busy">
                    @(_busy ? "…" : TC.WithdrawButton)
                </button>
            </div>
        </div>
    </div>
}

@if (_confirmingDisable)
{
    <div class="modal-overlay" @onclick="() => _confirmingDisable = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ai-key-disable-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 id="ai-key-disable-title">@T.AiKeyDisableConfirmTitle</h3>
                <button type="button" class="modal-close" aria-label="@T.AriaCloseDialog" @onclick="() => _confirmingDisable = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.AiKeyDisableConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingDisable = false" disabled="@_busy">
                    @T.AiKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmDisable" disabled="@_busy">
                    @(_busy ? "…" : T.AiKeyDisableConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();
    private I18nText.AiConsentText TC = new();
    private AiConsentStatusDto? _consent;
    private bool _confirmingWithdraw;

    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request, cascaded by Setup.razor next to the value: this
    /// card initialises with the page shell, before the page has awaited the bundle, so it waits
    /// for the task itself instead of falling back to a request the bundle is about to answer.</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private bool _hasKey;
    private DateTime? _createdAt;
    private bool _busy;
    private bool _reconnecting;
    private bool _reconnectSuccess;
    private bool _confirmingDisable;

    // The Overview instance last applied to this card's fields - lets OnParametersSet tell a
    // genuinely new bundle (another device/add-on changed something) apart from an unrelated
    // re-render of the parent that hands down the same cascaded instance again.
    private SetupOverviewDto? _appliedOverview;

    protected override async Task OnInitializedAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        TC = await I18nText.GetTextTableAsync<I18nText.AiConsentText>(this);
        _consent = await State.AiConsent.GetStatusAsync(refresh: true);
        if (Overview?.AiApiKey is { } bundled)
        {
            ApplyOverview(bundled);
            return;
        }
        try
        {
            var status = await Http.GetFromJsonAsync<AiApiKeyStatusDto>("api/settings/ai-api-key");
            _hasKey = status?.HasKey ?? false;
            _createdAt = status?.CreatedAt;
        }
        catch { /* offline: card shows the "disabled" default */ }
    }

    /// <summary>Live refresh: re-applies this card's section from a freshly re-fetched bundle,
    /// but only while nothing is in flight here - a background refresh must never overwrite an
    /// enable/disable/reconnect the user just triggered.</summary>
    protected override void OnParametersSet()
    {
        if (Overview is null || ReferenceEquals(Overview, _appliedOverview)) return;
        _appliedOverview = Overview;
        if (_busy || _reconnecting || _confirmingDisable) return;
        if (Overview.AiApiKey is { } bundled) ApplyOverview(bundled);
    }

    private void ApplyOverview(AiApiKeyStatusDto bundled)
    {
        _hasKey = bundled.HasKey;
        _createdAt = bundled.CreatedAt;
    }

    // Enable: generate a key and immediately discard the plaintext, same as AgentChatModal's
    // ActivateAsync - the server already registered it with studylife-ai by the time this
    // returns (or queued that registration in the outbox for retry), the user never sees it.
    private async Task Enable()
    {
        _busy = true;
        try
        {
            // The consent dialog (if one is needed) comes before anything is generated or
            // registered; "not now" leaves AI off without an error.
            if (!await State.AiConsent.EnsureConsentAsync()) return;
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/ai-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<AiApiKeyGenerateResponseDto>();
                _hasKey = true;
                _createdAt = dto?.CreatedAt;
            }
            _consent = await State.AiConsent.GetStatusAsync(refresh: true);
        }
        finally { _busy = false; }
    }

    // Recovery affordance for a broken registration (e.g. studylife-ai's copy of the key got
    // lost) - mints and registers a fresh key the same way Enable does, no confirmation since
    // there is nothing the user set up by hand that this could break.
    private async Task Reconnect()
    {
        _busy = true;
        _reconnecting = true;
        StateHasChanged();
        try
        {
            if (!await State.AiConsent.EnsureConsentAsync()) return;
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/ai-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<AiApiKeyGenerateResponseDto>();
                _hasKey = true;
                _createdAt = dto?.CreatedAt;
                _reconnectSuccess = true;
                StateHasChanged();
                await Task.Delay(2000);
                _reconnectSuccess = false;
            }
        }
        finally
        {
            _reconnecting = false;
            _busy = false;
            StateHasChanged();
        }
    }

    // Withdraw: the server clears the consent AND revokes the AI key through the existing revoke
    // path (which makes studylife-ai purge the user's indexed data) - one call, no client-side
    // sequencing.
    private async Task ConfirmWithdraw()
    {
        _confirmingWithdraw = false;
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            if (await State.AiConsent.WithdrawAsync())
            {
                _hasKey = false;
                _createdAt = null;
                _consent = await State.AiConsent.GetStatusAsync();
            }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmDisable()
    {
        _confirmingDisable = false;
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/ai-api-key/revoke", null);
            if (response.IsSuccessStatusCode)
            {
                _hasKey = false;
                _createdAt = null;
            }
        }
        finally { _busy = false; }
    }
}

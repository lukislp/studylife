@using StudyLife.Shared
@inject HttpClient Http
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived per-user API key for the studylife-ai integration - a SEPARATE slot from the
   Home Assistant key (AuthUserEntity.AiApiKeyHash vs ApiKeyHash, see SettingsController's
   ai-api-key group). UNLIKE the Home Assistant/MCP/Capture cards, this is a plain on/off
   toggle, not a reveal-once-plaintext lifecycle: nothing external ever needs the raw key -
   the server hands it to studylife-ai itself at generation time (AiProxyClient.
   RegisterKeyAsync via the AI key outbox) and only ever stores the SHA-256 hash locally, so
   the user has nothing to copy or paste anywhere. Same discard-immediately pattern as
   AgentChatModal's ActivateAsync: call generate, ignore the plaintext in the response.
   Deliberately no rotation warning/confirmation on "Reconnect" either - regenerating doesn't
   break anything the user configured by hand, it just asks the server to mint+register a
   fresh key, so it's framed as a lightweight recovery action, not a destructive one. Self-
   contained component (own SetupText instance + own HTTP calls), modeled after
   SetupProgressShareCard's enable/disable/regenerate-with-success-flash shape. *@

<div class="setup-section">
    <div class="ss-label">@T.AiIntegrationHeading</div>
    <p class="ss-desc">@T.AiIntegrationDesc</p>

    @if (_hasKey)
    {
        <p class="ss-desc" style="font-weight:600">
            ✅ @T.Enabled — @string.Format(T.AiKeyActiveSince ?? "", _createdAt?.ToLocalTime().ToString("g") ?? "")
        </p>
        <div class="toggle-row" style="gap:0.75rem;flex-wrap:wrap">
            <button type="button" class="btn-secondary" @onclick="Reconnect" disabled="@_busy">
                @(_reconnectSuccess ? $"✓ {T.AiKeyReconnectSuccess}" : (_reconnecting ? "…" : T.AiKeyReconnectButton))
            </button>
            <button type="button" class="btn-danger" @onclick="() => _confirmingDisable = true" disabled="@_busy">
                @T.AiKeyDisableButton
            </button>
        </div>
    }
    else
    {
        <p class="ss-desc">@T.Disabled</p>
        <button type="button" class="btn-secondary" @onclick="Enable" disabled="@_busy">
            @(_busy ? "…" : T.AiKeyEnableButton)
        </button>
    }
</div>

@if (_confirmingDisable)
{
    <div class="modal-overlay" @onclick="() => _confirmingDisable = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.AiKeyDisableConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingDisable = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.AiKeyDisableConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingDisable = false" disabled="@_busy">
                    @T.AiKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmDisable" disabled="@_busy">
                    @(_busy ? "…" : T.AiKeyDisableConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request, cascaded by Setup.razor next to the value: this
    /// card initialises with the page shell, before the page has awaited the bundle, so it waits
    /// for the task itself instead of falling back to a request the bundle is about to answer.</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private bool _hasKey;
    private DateTime? _createdAt;
    private bool _busy;
    private bool _reconnecting;
    private bool _reconnectSuccess;
    private bool _confirmingDisable;

    protected override async Task OnInitializedAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        if (Overview?.AiApiKey is { } bundled)
        {
            _hasKey = bundled.HasKey;
            _createdAt = bundled.CreatedAt;
            return;
        }
        try
        {
            var status = await Http.GetFromJsonAsync<AiApiKeyStatusDto>("api/settings/ai-api-key");
            _hasKey = status?.HasKey ?? false;
            _createdAt = status?.CreatedAt;
        }
        catch { /* offline: card shows the "disabled" default */ }
    }

    // Enable: generate a key and immediately discard the plaintext, same as AgentChatModal's
    // ActivateAsync - the server already registered it with studylife-ai by the time this
    // returns (or queued that registration in the outbox for retry), the user never sees it.
    private async Task Enable()
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/ai-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<AiApiKeyGenerateResponseDto>();
                _hasKey = true;
                _createdAt = dto?.CreatedAt;
            }
        }
        finally { _busy = false; }
    }

    // Recovery affordance for a broken registration (e.g. studylife-ai's copy of the key got
    // lost) - mints and registers a fresh key the same way Enable does, no confirmation since
    // there is nothing the user set up by hand that this could break.
    private async Task Reconnect()
    {
        _busy = true;
        _reconnecting = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync("api/settings/ai-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<AiApiKeyGenerateResponseDto>();
                _hasKey = true;
                _createdAt = dto?.CreatedAt;
                _reconnectSuccess = true;
                StateHasChanged();
                await Task.Delay(2000);
                _reconnectSuccess = false;
            }
        }
        finally
        {
            _reconnecting = false;
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDisable()
    {
        _confirmingDisable = false;
        _busy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/ai-api-key/revoke", null);
            if (response.IsSuccessStatusCode)
            {
                _hasKey = false;
                _createdAt = null;
            }
        }
        finally { _busy = false; }
    }
}

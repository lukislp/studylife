@using StudyLife.Client.Models
@using StudyLife.Shared

<div class="setup-section">
    <div class="ss-label">@Label</div>
    <p class="ss-desc">@Desc</p>

    @if (Modes.Count > 0)
    {
        <div class="custom-mode-list">
            @foreach (var mode in Modes)
            {
                var m = mode;
                <div class="custom-mode-row">
                    <span class="cm-emoji">@m.Emoji</span>
                    <span class="cm-name">@m.Name</span>
                    <span class="cm-meta">@m.FocusMinutes' / @m.BreakMinutes' × @m.Rounds</span>
                    <button type="button" class="cm-delete" aria-label="@DeleteLabel" @onclick="() => OnDelete.InvokeAsync(m.Id)">✕</button>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div style="color:var(--danger,#e74c3c);font-size:0.8rem;margin-bottom:0.5rem">⚠️ @_error</div>
    }
    <div class="field" style="margin-bottom:0.75rem">
        <input class="input input-sm" maxlength="24" placeholder="@NamePlaceholder" @bind="_name" @bind:event="oninput" @bind:after="ClearError" />
    </div>
    <div class="field-row" style="margin-bottom:0.75rem">
        <div class="field">
            <label>@FocusLabel</label>
            <input class="input input-sm" type="number" min="@TimerModeCatalog.MinFocusMinutes" max="@TimerModeCatalog.MaxFocusMinutes" @bind="_focusMinutes" @bind:after="ClearError" />
        </div>
        <div class="field">
            <label>@BreakLabel</label>
            <input class="input input-sm" type="number" min="@TimerModeCatalog.MinBreakMinutes" max="@TimerModeCatalog.MaxBreakMinutes" @bind="_breakMinutes" @bind:after="ClearError" />
        </div>
        <div class="field">
            <label>@RoundsLabel</label>
            <input class="input input-sm" type="number" min="@TimerModeCatalog.MinRounds" max="@TimerModeCatalog.MaxRounds" @bind="_rounds" @bind:after="ClearError" />
        </div>
    </div>
    <button type="button" class="btn-secondary" disabled="@string.IsNullOrWhiteSpace(_name)" @onclick="Add">@AddButtonText</button>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Desc { get; set; } = "";
    [Parameter] public string DeleteLabel { get; set; } = "";
    [Parameter] public string NamePlaceholder { get; set; } = "";
    [Parameter] public string FocusLabel { get; set; } = "";
    [Parameter] public string BreakLabel { get; set; } = "";
    [Parameter] public string RoundsLabel { get; set; } = "";
    [Parameter] public string AddButtonText { get; set; } = "";
    /// <summary>Shown instead of adding when the entered name (case-insensitively) already
    /// belongs to another custom mode - two modes with the same name would be indistinguishable
    /// wherever modes are picked by name (Focus page, session dialogs).</summary>
    [Parameter] public string? DuplicateNameError { get; set; }
    /// <summary>Format string shown instead of adding when focus/break/rounds is outside the
    /// TimerModeCatalog bounds; {0}-{5} = focus min/max, break min/max, rounds min/max. Out-of-range
    /// input is refused visibly rather than clamped, so the saved mode always matches what was
    /// typed.</summary>
    [Parameter] public string? RangeError { get; set; }
    [Parameter] public List<TimerMode> Modes { get; set; } = new();
    /// <summary>New mode without an ID - the parent assigns the ID and serializes (deferred save-button flow).</summary>
    [Parameter] public EventCallback<TimerMode> OnAdd { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private string _name = "";
    private int _focusMinutes = 25;
    private int _breakMinutes = 5;
    private int _rounds = 4;
    private string? _error;

    private async Task Add()
    {
        var name = _name.Trim();
        if (name.Length == 0) return;
        if (name.Length > 24) name = name[..24];
        if (Modes.Any(m => string.Equals(m.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _error = DuplicateNameError;
            return;
        }
        if (!IsInRange(_focusMinutes, _breakMinutes, _rounds))
        {
            _error = string.Format(RangeError ?? "",
                TimerModeCatalog.MinFocusMinutes, TimerModeCatalog.MaxFocusMinutes,
                TimerModeCatalog.MinBreakMinutes, TimerModeCatalog.MaxBreakMinutes,
                TimerModeCatalog.MinRounds, TimerModeCatalog.MaxRounds);
            return;
        }
        var mode = new TimerMode
        {
            Name = name,
            FocusMinutes = _focusMinutes,
            BreakMinutes = _breakMinutes,
            Rounds = _rounds,
        };
        _name = "";
        _error = null;
        await OnAdd.InvokeAsync(mode);
    }

    private void ClearError() => _error = null;

    /// <summary>Same bounds TimerModeCatalog.ParseCustom clamps to on read - anything accepted
    /// here round-trips unchanged to the Focus page, the native app and the Live Activity push.</summary>
    public static bool IsInRange(int focusMinutes, int breakMinutes, int rounds) =>
        focusMinutes is >= TimerModeCatalog.MinFocusMinutes and <= TimerModeCatalog.MaxFocusMinutes
        && breakMinutes is >= TimerModeCatalog.MinBreakMinutes and <= TimerModeCatalog.MaxBreakMinutes
        && rounds is >= TimerModeCatalog.MinRounds and <= TimerModeCatalog.MaxRounds;
}

@using StudyLife.Shared
@using StudyLife.Client.Services
@inject HttpClient Http
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived per-user API key for the studylife-developers portal - a SEPARATE slot
   (AuthUserEntity.DeveloperApiKeyHash), same toggle-not-reveal shape as SetupAiIntegrationCard:
   nothing external ever needs the raw key, the server hands it to studylife-developers itself
   at generation time (DeveloperProxyClient.RegisterKeyAsync) and only ever stores the SHA-256
   hash locally. Scoped EXCLUSIVELY to managing one's own OAuthClientEntity registrations
   (ApiKeyScopes.Developer) - never any study data, and deliberately separate from the generic
   add-on-connect flow any INSTALLED third-party add-on uses. Self-contained component (own
   SetupText instance + own HTTP calls), modeled directly after SetupAiIntegrationCard. *@

<div class="setup-section">
    <div class="ss-label">@T.DeveloperHeading</div>
    <p class="ss-desc">@T.DeveloperDesc</p>

    @if (_hasKey)
    {
        <p class="ss-desc" style="font-weight:600">✅ @T.Enabled</p>
        <div class="toggle-row" style="gap:0.75rem;flex-wrap:wrap">
            <button type="button" class="btn-secondary" @onclick="Reconnect" disabled="@_busy">
                @(_reconnectSuccess ? $"✓ {T.DeveloperReconnectSuccess}" : (_reconnecting ? "…" : T.DeveloperReconnectButton))
            </button>
            <button type="button" class="btn-danger" @onclick="() => _confirmingDisable = true" disabled="@_busy">
                @T.DeveloperDisableButton
            </button>
        </div>
    }
    else
    {
        <p class="ss-desc">@T.Disabled</p>
        <button type="button" class="btn-secondary" @onclick="Enable" disabled="@_busy">
            @(_busy ? "…" : T.DeveloperEnableButton)
        </button>
    }
</div>

@if (_confirmingDisable)
{
    <div class="modal-overlay" @onclick="() => _confirmingDisable = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.DeveloperDisableConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingDisable = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.DeveloperDisableConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingDisable = false" disabled="@_busy">
                    @T.DeveloperConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmDisable" disabled="@_busy">
                    @(_busy ? "…" : T.DeveloperDisableConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request, cascaded by Setup.razor next to the value: this
    /// card initialises with the page shell, before the page has awaited the bundle, so it waits
    /// for the task itself instead of falling back to a request the bundle is about to answer.</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private bool _hasKey;
    private bool _busy;
    private bool _reconnecting;
    private bool _reconnectSuccess;
    private bool _confirmingDisable;

    // The Overview instance last applied to this card's fields - lets OnParametersSet tell a
    // genuinely new bundle (another device/add-on changed something) apart from an unrelated
    // re-render of the parent that hands down the same cascaded instance again.
    private SetupOverviewDto? _appliedOverview;

    protected override async Task OnInitializedAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        if (Overview?.DeveloperApiKey is { } bundled)
        {
            ApplyOverview(bundled);
            return;
        }
        try
        {
            var status = await Http.GetFromJsonAsync<DeveloperApiKeyStatusDto>("api/settings/developer-api-key");
            _hasKey = status?.HasKey ?? false;
        }
        catch { /* offline: card shows the "disabled" default */ }
    }

    /// <summary>Live refresh: re-applies this card's section from a freshly re-fetched bundle,
    /// but only while nothing is in flight here - a background refresh must never overwrite an
    /// enable/disable/reconnect the user just triggered.</summary>
    protected override void OnParametersSet()
    {
        if (Overview is null || ReferenceEquals(Overview, _appliedOverview)) return;
        _appliedOverview = Overview;
        if (_busy || _reconnecting || _confirmingDisable) return;
        if (Overview.DeveloperApiKey is { } bundled) ApplyOverview(bundled);
    }

    private void ApplyOverview(DeveloperApiKeyStatusDto bundled) => _hasKey = bundled.HasKey;

    private async Task Enable()
    {
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/developer-api-key/generate", null);
            if (response.IsSuccessStatusCode) _hasKey = true;
        }
        finally { _busy = false; }
    }

    private async Task Reconnect()
    {
        _busy = true;
        _reconnecting = true;
        StateHasChanged();
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/developer-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                _hasKey = true;
                _reconnectSuccess = true;
                StateHasChanged();
                await Task.Delay(2000);
                _reconnectSuccess = false;
            }
        }
        finally
        {
            _reconnecting = false;
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDisable()
    {
        _confirmingDisable = false;
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/developer-api-key/revoke", null);
            if (response.IsSuccessStatusCode) _hasKey = false;
        }
        finally { _busy = false; }
    }
}

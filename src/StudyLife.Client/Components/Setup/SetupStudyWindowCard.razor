<div class="setup-section">
    <div class="ss-label">@Label</div>
    <p class="ss-desc">@Desc</p>
    <div class="field-row" style="margin-bottom:0.75rem">
        <div class="field">
            <label>@FromLabel</label>
            <select class="select input-sm" value="@StartHour"
                    @onchange="e => StartHourChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var v) ? v : StartHour)">
                @for (var h = 0; h <= 22; h++)
                {
                    <option value="@h">@(h.ToString("00")):00</option>
                }
            </select>
        </div>
        <div class="field">
            <label>@ToLabel</label>
            <select class="select input-sm" value="@EndHour"
                    @onchange="e => EndHourChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var v) ? v : EndHour)">
                @for (var h = 1; h <= 23; h++)
                {
                    <option value="@h">@(h.ToString("00")):00</option>
                }
            </select>
        </div>
    </div>
    <div class="field">
        <label>@DaysLabel</label>
        <div class="weekday-picker">
            @foreach (var day in StudyDayDisplayOrder)
            {
                var d = day;
                <button type="button" class="weekday-chip @(SelectedDays.Contains(d) ? "selected" : "")"
                        @onclick="() => OnDayToggle.InvokeAsync(d)">@StudyDayShortLabel(d)</button>
            }
        </div>
    </div>
</div>

@code {
    private static readonly int[] StudyDayDisplayOrder = { 1, 2, 3, 4, 5, 6, 0 };

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Desc { get; set; } = "";
    [Parameter] public string FromLabel { get; set; } = "";
    [Parameter] public string ToLabel { get; set; } = "";
    [Parameter] public string DaysLabel { get; set; } = "";
    [Parameter] public int StartHour { get; set; }
    [Parameter] public EventCallback<int> StartHourChanged { get; set; }
    [Parameter] public int EndHour { get; set; }
    [Parameter] public EventCallback<int> EndHourChanged { get; set; }
    [Parameter] public HashSet<int> SelectedDays { get; set; } = new();
    [Parameter] public EventCallback<int> OnDayToggle { get; set; }

    private static string StudyDayShortLabel(int dayOfWeek)
    {
        var mondayRef = new DateTime(2024, 1, 1);
        var offset = (dayOfWeek - 1 + 7) % 7;
        return mondayRef.AddDays(offset).ToString("ddd");
    }
}

@using StudyLife.Shared
@using StudyLife.Client.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived per-user API key for Home Assistant (phase 3): replaces the former global,
   monthly-rotating key along with its bootstrap endpoint. The plaintext key, like a
   password, is ONLY visible right after generation (the server stores exclusively the
   SHA-256 hash) - after that the card just shows "active since ...". Deliberately no
   rotation: HA has no live session that could pick up a rotation. Self-contained component
   modeled after SetupProgressShareCard (its own SetupText instance + its own HTTP calls),
   Setup.razor just wires it in. Regenerating and revoking immediately invalidate the
   existing key and thus break the HA coupling - hence a two-step confirmation modal for each
   (.modal-overlay/.modal/.modal-footer pattern, no native confirm()). *@

<div class="setup-section">
    <div class="ss-label">@T.HomeAssistantHeading</div>
    <p class="ss-desc">@T.HomeAssistantDesc</p>

    @if (!string.IsNullOrEmpty(_generatedKey))
    {
        <div class="field-row" style="flex-wrap:wrap">
            <input class="input" readonly value="@_generatedKey" />
            <button type="button" class="btn-secondary" style="flex-shrink:0" @onclick="CopyKey">
                @(_copied ? $"✓ {T.Copied}" : T.Copy)
            </button>
        </div>
        <p class="ss-desc" style="font-weight:600">⚠️ @T.HaKeyOnceHint</p>
    }

    @if (_hasKey)
    {
        <p class="ss-desc">@string.Format(T.HaKeyActiveSince ?? "", _createdAt?.ToLocalTime().ToString("g") ?? "")</p>
        <div class="toggle-row" style="gap:0.75rem;flex-wrap:wrap">
            <button type="button" class="btn-secondary" @onclick="() => _confirmingRegenerate = true" disabled="@_busy">
                @T.HaKeyRegenerateButton
            </button>
            <button type="button" class="btn-danger" @onclick="() => _confirmingRevoke = true" disabled="@_busy">
                @T.HaKeyRevokeButton
            </button>
        </div>
    }
    else
    {
        <button type="button" class="btn-secondary" @onclick="Generate" disabled="@_busy">
            @(_busy ? "…" : T.HaKeyGenerateButton)
        </button>
    }
</div>

@if (_confirmingRegenerate)
{
    <div class="modal-overlay" @onclick="() => _confirmingRegenerate = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.HaKeyRegenerateConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingRegenerate = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.HaKeyRegenerateConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingRegenerate = false" disabled="@_busy">
                    @T.HaKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmRegenerate" disabled="@_busy">
                    @(_busy ? "…" : T.HaKeyRegenerateConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@if (_confirmingRevoke)
{
    <div class="modal-overlay" @onclick="() => _confirmingRevoke = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.HaKeyRevokeConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingRevoke = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.HaKeyRevokeConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingRevoke = false" disabled="@_busy">
                    @T.HaKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmRevoke" disabled="@_busy">
                    @(_busy ? "…" : T.HaKeyRevokeConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    // Set by Setup.razor's <CascadingValue> around setup-sections - see SetupOverviewDto.
    // Read once in OnInitializedAsync below; a section present there skips this card's own GET.
    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request, cascaded by Setup.razor next to the value: this
    /// card initialises with the page shell, before the page has awaited the bundle, so it waits
    /// for the task itself instead of falling back to a request the bundle is about to answer.</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private bool _hasKey;
    private DateTime? _createdAt;
    // Plaintext only visible right after a generation within this page load - the server
    // never gives it out again (only the hash lives in the DB).
    private string? _generatedKey;
    private bool _copied;
    private bool _busy;
    private bool _confirmingRegenerate;
    private bool _confirmingRevoke;

    // The Overview instance last applied to this card's fields - lets OnParametersSet tell a
    // genuinely new bundle (another device/add-on changed something) apart from an unrelated
    // re-render of the parent that hands down the same cascaded instance again.
    private SetupOverviewDto? _appliedOverview;

    protected override async Task OnInitializedAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        if (Overview?.HaApiKey is { } bundled)
        {
            ApplyOverview(bundled);
            return;
        }
        try
        {
            var status = await Http.GetFromJsonAsync<HaApiKeyStatusDto>("api/settings/ha-api-key");
            _hasKey = status?.HasKey ?? false;
            _createdAt = status?.CreatedAt;
        }
        catch { /* offline: card shows the "no key" default */ }
    }

    /// <summary>
    /// Live refresh (Setup.razor's server-change subscription re-fetches the whole overview
    /// bundle and hands down a new instance): re-applies this card's section the same way the
    /// initial load does - but only while nothing is in flight here (generate/revoke, or the
    /// confirmation modals), so a background refresh can never overwrite an action the user is
    /// mid-way through, and never touches _generatedKey - the freshly generated plaintext key
    /// stays visible regardless of what a later bundle says.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Overview is null || ReferenceEquals(Overview, _appliedOverview)) return;
        _appliedOverview = Overview;
        if (_busy || _confirmingRegenerate || _confirmingRevoke) return;
        if (Overview.HaApiKey is { } bundled) ApplyOverview(bundled);
    }

    private void ApplyOverview(HaApiKeyStatusDto bundled)
    {
        _hasKey = bundled.HasKey;
        _createdAt = bundled.CreatedAt;
    }

    private async Task Generate()
    {
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/ha-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<HaApiKeyGenerateResponseDto>();
                if (!string.IsNullOrEmpty(dto?.ApiKey))
                {
                    _generatedKey = dto!.ApiKey;
                    _hasKey = true;
                    _createdAt = dto.CreatedAt;
                }
            }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmRegenerate()
    {
        _confirmingRegenerate = false;
        await Generate();
    }

    private async Task ConfirmRevoke()
    {
        _confirmingRevoke = false;
        _busy = true;
        try
        {
            State.NoteOwnWrite("settings");
            var response = await Http.PostAsync("api/settings/ha-api-key/revoke", null);
            if (response.IsSuccessStatusCode)
            {
                _hasKey = false;
                _createdAt = null;
                _generatedKey = null;
            }
        }
        finally { _busy = false; }
    }

    private async Task CopyKey()
    {
        if (string.IsNullOrEmpty(_generatedKey)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedKey);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}

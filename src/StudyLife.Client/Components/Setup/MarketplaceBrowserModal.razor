@using StudyLife.Shared
@inject MarketplaceClient MarketplaceClient
@inject HttpClient Http
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Browses studylife-marketplace's public catalog (fetched client-side, see MarketplaceClient -
   no StudyLife.Server involvement) and installs a listing by materializing a local
   OAuthClientEntity (reusing DeveloperController.Create unchanged), or by checking that an
   existing registration under the listing's id is exactly the listing's add-on
   (MarketplaceRegistrationMatch, 2026-11-16 audit M5). Connecting then starts from the add-on
   itself, which brings its own state and PKCE challenge to the consent page
   (ConnectClient.razor). See StudyLifeMarketplacePlan for the full design - in particular why
   RedirectUriPattern is used as one literal redirect URI.

   Demo mode: browsing stays fully functional (GitHub fetch, not this app's own API), but
   installing is disabled here too. This is a UX nicety, not the actual enforcement - the
   server's own demo write-block middleware (Program.cs, DemoModeGuard) already 403s every
   mutating /api call except /api/auth/demo-login and /api/dictate, which already covers
   POST api/developer/clients and api/auth/connect with zero changes needed there. *@

<div class="modal-overlay" @onclick="() => OnClose.InvokeAsync()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="marketplace-browser-title" @onclick:stopPropagation="true" style="max-width:560px;max-height:85vh;display:flex;flex-direction:column">
        <div class="modal-header">
            <h3 id="marketplace-browser-title">@T.MarketplaceHeading</h3>
            <button type="button" class="modal-close" aria-label="@T.AriaCloseDialog" @onclick="() => OnClose.InvokeAsync()">✕</button>
        </div>
        <div class="modal-body" style="overflow-y:auto;flex:1 1 auto;min-height:0">
            @if (_loading)
            {
                <p class="ss-desc">@T.MarketplaceLoading</p>
            }
            else if (_fetchError)
            {
                <p class="ss-desc" style="color:var(--danger, #e74c3c)">@T.MarketplaceFetchFailed</p>
            }
            else if (_listings.Count == 0)
            {
                <p class="ss-desc">@T.MarketplaceEmpty</p>
            }
            else
            {
                @if (_isDemo)
                {
                    <p class="ss-desc">@T.MarketplaceDemoNotice</p>
                }
                @foreach (var listing in _listings)
                {
                    <div class="field-row" style="flex-wrap:wrap;align-items:flex-start;border-bottom:1px solid var(--border);padding-bottom:0.75rem;margin-bottom:0.75rem">
                        <div style="flex:1;min-width:240px">
                            <strong>@listing.Name</strong>
                            <span class="ss-desc" style="margin-left:6px">@string.Format(T.MarketplaceByDeveloper ?? "{0}", listing.Developer)</span>
                            <div class="ss-desc" style="margin:2px 0 0">@listing.Description</div>
                            <div class="ss-desc" style="margin:4px 0 0">
                                @T.MarketplaceScopesLabel
                                @string.Join(", ", listing.RequestedScopes.Select(MarketplaceScopeLabels.Describe))
                            </div>
                            @if (WebLinkPolicy.IsWebLink(listing.Repository))
                            {
                                <a href="@listing.Repository" target="_blank" rel="noopener noreferrer" class="ss-desc">@T.MarketplaceViewSource</a>
                            }
                        </div>
                        @if (listing.RequiresManualSetup)
                        {
                            <div style="flex-basis:100%">
                                <p class="ss-desc" style="margin:4px 0 0">@T.MarketplaceManualSetupNotice</p>
                                @if (listing.SafeSetupUrl is { } setupUrl)
                                {
                                    <a href="@setupUrl" target="_blank" rel="noopener noreferrer" class="ss-desc">@T.MarketplaceManualSetupLink</a>
                                }
                            </div>
                        }
                        else if (listing.CanInstallOneClick)
                        {
                            <div class="toggle-row" style="gap:0.5rem;flex-shrink:0">
                                <button type="button" class="btn-secondary" disabled="@(_busyClientId != null || _isDemo)"
                                        @onclick="() => InstallAsync(listing)">
                                    @(_busyClientId == listing.Id ? "…" : T.MarketplaceInstallButton)
                                </button>
                            </div>
                        }
                    </div>
                    @if (_installError != null && _installErrorClientId == listing.Id)
                    {
                        <p class="ss-desc" style="color:var(--danger, #e74c3c);margin-top:-0.5rem">@_installError</p>
                    }
                    @if (_installNotice != null && _installNoticeClientId == listing.Id)
                    {
                        <p class="ss-desc" style="margin-top:-0.5rem" data-testid="marketplace-install-notice">@_installNotice</p>
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private I18nText.SetupText T = new();
    private List<MarketplaceListingDto> _listings = new();
    private bool _loading = true;
    private bool _fetchError;
    private bool _isDemo;
    private string? _busyClientId;
    private string? _installError;
    private string? _installErrorClientId;
    private string? _installNotice;
    private string? _installNoticeClientId;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        _isDemo = await State.GetIsDemoAsync();
        try
        {
            _listings = await MarketplaceClient.GetListingsAsync();
        }
        catch
        {
            _fetchError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task InstallAsync(MarketplaceListingDto listing)
    {
        _busyClientId = listing.Id;
        _installError = null;
        _installNotice = null;
        try
        {
            // Install only makes sure this server has a registration that really is the
            // listing's add-on (2026-11-16 audit M5). It no longer opens the consent screen
            // itself: the add-on starts that flow with its own state and PKCE challenge, which
            // a consent round trip started here could never carry.
            var existing = await Http.GetAsync($"api/auth/oauth-clients/{Uri.EscapeDataString(listing.Id)}");
            string approval;
            if (existing.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                var createResponse = await Http.PostAsJsonAsync("api/developer/clients", new CreateDeveloperClientRequestDto
                {
                    ClientId = listing.Id,
                    Name = listing.Name,
                    Description = listing.Description,
                    AllowedRedirectUris = new List<string> { listing.RedirectUriPattern },
                    RequestedScopes = listing.RequestedScopes,
                });
                var created = createResponse.IsSuccessStatusCode
                    ? await createResponse.Content.ReadFromJsonAsync<DeveloperClientDto>()
                    : null;
                if (created is null)
                {
                    _installError = T.MarketplaceInstallFailed;
                    _installErrorClientId = listing.Id;
                    return;
                }
                approval = created.Approval;
            }
            else
            {
                var info = existing.IsSuccessStatusCode
                    ? await existing.Content.ReadFromJsonAsync<OAuthClientInfoDto>()
                    : null;
                if (info is null)
                {
                    _installError = T.MarketplaceInstallFailed;
                    _installErrorClientId = listing.Id;
                    return;
                }
                // Somebody on this server may have registered the listing's id first (id
                // squatting): never treat a registration with other redirect targets or other
                // access as the listing's add-on.
                if (!MarketplaceRegistrationMatch.Matches(listing, info))
                {
                    _installError = T.MarketplaceInstallMismatch;
                    _installErrorClientId = listing.Id;
                    return;
                }
                approval = info.Approval;
            }

            _installNotice = approval switch
            {
                OAuthClientApprovalStates.Approved => T.MarketplaceInstallReady,
                OAuthClientApprovalStates.Rejected => T.MarketplaceInstallRejected,
                _ => T.MarketplaceInstallPendingApproval,
            };
            _installNoticeClientId = listing.Id;
        }
        catch (HttpRequestException)
        {
            _installError = T.MarketplaceInstallFailed;
            _installErrorClientId = listing.Id;
        }
        finally
        {
            _busyClientId = null;
        }
    }
}

@using StudyLife.Shared
@using StudyLife.Client.Services
@inject HttpClient Http
@inject IServerLinks Links
@inject IJSRuntime JS
@inject AppStateService State
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Subscribable ICS calendar feed (GET api/sessions/ics?calendarToken=...). The token is stored on
   the server only as a hash (audit 2026-11-16 L5), so the subscription URL exists in this card
   exactly once: right after "Create" or "Regenerate" (POST api/system/regenerate-calendar-token).
   Afterwards the card can only say that a link is active (OneTimeLink decides the state).
   Self-contained like SetupProgressShareCard: own SetupText instance and own HTTP calls.
   Regenerating replaces the link and breaks every existing subscription, hence the two-step
   confirmation modal (same .modal-overlay/.modal/.modal-footer pattern as SetupRestoreCard). *@

<div class="setup-section">
    <div class="ss-label">@T.CalendarSubscriptionHeading</div>
    <p class="ss-desc">@T.CalendarSubscriptionDesc</p>

    @switch (View)
    {
        case OneTimeLinkView.Shown:
            <div class="field-row">
                <input class="input" readonly value="@IcsUrl" />
                <button type="button" class="btn-secondary" @onclick="CopyUrl" style="flex-shrink:0">
                    @(_copied ? $"✓ {T.Copied}" : T.Copy)
                </button>
                <button type="button" class="btn-danger" @onclick="() => _confirming = true" disabled="@_busy" style="flex-shrink:0">
                    @(_regenerateSuccess ? $"✓ {T.CalendarRegenerateSuccess}" : T.CalendarRegenerateButton)
                </button>
            </div>
            <p class="ss-desc" role="status">@T.LinkShownOnceNotice</p>
            break;
        case OneTimeLinkView.Hidden:
            <p class="ss-desc">@T.LinkHiddenNotice</p>
            <button type="button" class="btn-danger" @onclick="() => _confirming = true" disabled="@_busy">
                @T.CalendarRegenerateButton
            </button>
            break;
        default:
            <button type="button" class="btn-secondary" @onclick="Create" disabled="@(_busy || !_loaded)">
                @T.CalendarLinkCreateButton
            </button>
            break;
    }
</div>

@if (_confirming)
{
    <div class="modal-overlay" @onclick="() => _confirming = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="calendar-subscription-regenerate-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 id="calendar-subscription-regenerate-title">@T.CalendarRegenerateConfirmTitle</h3>
                <button type="button" class="modal-close" aria-label="@T.AriaCloseDialog" @onclick="() => _confirming = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.CalendarRegenerateConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirming = false" disabled="@_busy">
                    @T.CalendarRegenerateConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmRegenerate" disabled="@_busy">
                    @(_busy ? "…" : T.CalendarRegenerateConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request (see SetupProgressShareCard.OverviewTask).</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private bool _exists;
    private string? _token;
    private bool _copied;
    private bool _busy;
    private bool _confirming;
    private bool _regenerateSuccess;
    // False until the initial status is known. Until then "Create" stays disabled: a link issued
    // before the initial status arrived would be overwritten by it and never shown.
    private bool _loaded;

    private OneTimeLinkView View => OneTimeLink.Of(_exists, _token);

    // IServerLinks instead of Nav.BaseUri: identical in the browser, but in the native app
    // Nav.BaseUri is the virtual WebView host (app://0.0.0.1/) - a subscription URL built with
    // that couldn't be fetched by any calendar client in the world.
    private string IcsUrl => string.IsNullOrEmpty(_token)
        ? ""
        : Links.Absolute($"api/sessions/ics?calendarToken={Uri.EscapeDataString(_token)}");

    protected override async Task OnInitializedAsync()
    {
        try { await LoadStatusAsync(); }
        finally { _loaded = true; }
    }

    private async Task LoadStatusAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        if (Overview?.CalendarLink is { } bundled)
        {
            Apply(bundled);
            return;
        }
        try
        {
            // Also the path against a server from before L5: it has no CalendarLink section and
            // answers this endpoint with the plaintext token, which Apply then shows.
            var dto = await Http.GetFromJsonAsync<CalendarTokenResponseDto>("api/system/calendar-token");
            if (dto is not null) Apply(dto);
        }
        catch { /* offline: the card offers to create a link */ }
    }

    private void Apply(CalendarTokenResponseDto status)
    {
        _token = status.CalendarToken;
        _exists = status.Exists || !string.IsNullOrEmpty(status.CalendarToken);
    }

    /// <summary>Creates or replaces the link; on success the new token is in hand (shown once).</summary>
    private async Task<bool> IssueAsync()
    {
        State.NoteOwnWrite("system");
        var response = await Http.PostAsync("api/system/regenerate-calendar-token", null);
        if (!response.IsSuccessStatusCode) return false;
        var dto = await response.Content.ReadFromJsonAsync<RegenerateCalendarTokenResponseDto>();
        if (string.IsNullOrEmpty(dto?.CalendarToken)) return false;
        _token = dto.CalendarToken;
        _exists = true;
        return true;
    }

    private async Task Create()
    {
        _busy = true;
        try { await IssueAsync(); }
        finally { _busy = false; }
    }

    private async Task CopyUrl()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", IcsUrl);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private async Task ConfirmRegenerate()
    {
        _busy = true;
        StateHasChanged();
        bool issued;
        try
        {
            issued = await IssueAsync();
        }
        finally
        {
            _confirming = false;
            _busy = false;
            StateHasChanged();
        }
        if (!issued) return;
        _regenerateSuccess = true;
        StateHasChanged();
        await Task.Delay(2000);
        _regenerateSuccess = false;
        StateHasChanged();
    }
}

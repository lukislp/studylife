@using StudyLife.Shared
@inject HttpClient Http
@inject IJSRuntime JS
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived, NAMED API keys for studylife-webhooks (see WebhookApiKeyEntity): unlike every
   other slot's single generate/revoke lifecycle (SetupHomeAssistantCard), a user can hold many
   of these at once - one per external program/add-on they want to let manage its own webhook
   subscriptions. List + create-with-name + delete-per-row, closer in shape to the webhook
   registration list itself (WebhooksProxyController) than to SetupHomeAssistantCard. Self-
   contained component (own SetupText instance + own HTTP calls), same style as that card. *@

<div class="setup-section">
    <div class="ss-label">@T.WebhooksHeading</div>
    <p class="ss-desc">@T.WebhooksDesc</p>

    @foreach (var key in _keys)
    {
        <div class="field-row" style="flex-wrap:wrap">
            <div style="flex:1;min-width:0">
                <strong>@key.Name</strong>
                <div class="ss-desc" style="margin:0">@string.Format(T.WebhooksKeyActiveSince ?? "", key.CreatedAt.ToLocalTime().ToString("g"))</div>
            </div>
            <button type="button" class="btn-danger" style="flex-shrink:0" @onclick="() => _confirmingRevokeId = key.Id" disabled="@_busy">
                @T.WebhooksKeyRevokeButton
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_generatedKey))
    {
        <div class="field-row" style="flex-wrap:wrap">
            <input class="input" readonly value="@_generatedKey" />
            <button type="button" class="btn-secondary" style="flex-shrink:0" @onclick="CopyKey">
                @(_copied ? $"✓ {T.Copied}" : T.Copy)
            </button>
        </div>
        <p class="ss-desc" style="font-weight:600">⚠️ @T.WebhooksKeyOnceHint</p>
    }

    <div class="field-row" style="flex-wrap:wrap">
        <input class="input" placeholder="@T.WebhooksKeyNamePlaceholder" @bind="_newKeyName" @bind:event="oninput" disabled="@_busy" />
        <button type="button" class="btn-secondary" style="flex-shrink:0" @onclick="Generate" disabled="@(_busy || string.IsNullOrWhiteSpace(_newKeyName))">
            @(_busy ? "…" : T.WebhooksKeyGenerateButton)
        </button>
    </div>
</div>

@if (_confirmingRevokeId is { } revokeId)
{
    <div class="modal-overlay" @onclick="() => _confirmingRevokeId = null">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.WebhooksKeyRevokeConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingRevokeId = null">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.WebhooksKeyRevokeConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingRevokeId = null" disabled="@_busy">
                    @T.WebhooksKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="() => ConfirmRevoke(revokeId)" disabled="@_busy">
                    @(_busy ? "…" : T.WebhooksKeyRevokeConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    [CascadingParameter]
    public SetupOverviewDto? Overview { get; set; }
    /// <summary>The in-flight bundle request, cascaded by Setup.razor next to the value: this
    /// card initialises with the page shell, before the page has awaited the bundle, so it waits
    /// for the task itself instead of falling back to a request the bundle is about to answer.</summary>
    [CascadingParameter(Name = "OverviewTask")]
    public Task<SetupOverviewDto?>? OverviewTask { get; set; }

    private List<WebhookApiKeyDto> _keys = new();
    private string _newKeyName = "";
    // Plaintext only visible right after a generation within this page load - the server
    // never gives it out again (only the hash lives in the DB).
    private string? _generatedKey;
    private bool _copied;
    private bool _busy;
    private int? _confirmingRevokeId;

    protected override async Task OnInitializedAsync()
    {
        if (OverviewTask is not null) Overview = await OverviewTask;
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        if (Overview?.WebhookApiKeys is { } bundled)
        {
            _keys = bundled;
            return;
        }
        try
        {
            _keys = await Http.GetFromJsonAsync<List<WebhookApiKeyDto>>("api/settings/webhooks-api-keys") ?? new();
        }
        catch { /* offline: card shows an empty list */ }
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(_newKeyName)) return;
        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/settings/webhooks-api-keys",
                new CreateWebhookApiKeyRequestDto { Name = _newKeyName.Trim() });
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<CreateWebhookApiKeyResponseDto>();
                if (!string.IsNullOrEmpty(dto?.ApiKey))
                {
                    _generatedKey = dto.ApiKey;
                    _keys.Add(new WebhookApiKeyDto { Id = dto.Id, Name = dto.Name, CreatedAt = dto.CreatedAt });
                    _newKeyName = "";
                }
            }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmRevoke(int id)
    {
        _confirmingRevokeId = null;
        _busy = true;
        try
        {
            var response = await Http.DeleteAsync($"api/settings/webhooks-api-keys/{id}");
            if (response.IsSuccessStatusCode)
                _keys.RemoveAll(k => k.Id == id);
        }
        finally { _busy = false; }
    }

    private async Task CopyKey()
    {
        if (string.IsNullOrEmpty(_generatedKey)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedKey);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}

@using StudyLife.Shared
@inject HttpClient Http
@inject IJSRuntime JS
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

@* Long-lived per-user API key for studylife-webhooks (see WebhooksApiKeyHash): manually
   generated here rather than provisioned through a consent flow, same reasoning as
   SetupHomeAssistantCard - there is no single dedicated client, any external program the
   user wants to let register webhook subscriptions gets handed this one key. Identical
   generate/regenerate/revoke lifecycle and markup as that card (own SetupText instance +
   own HTTP calls), just pointed at the webhooks-api-key endpoints. *@

<div class="setup-section">
    <div class="ss-label">@T.WebhooksHeading</div>
    <p class="ss-desc">@T.WebhooksDesc</p>

    @if (!string.IsNullOrEmpty(_generatedKey))
    {
        <div class="field-row" style="flex-wrap:wrap">
            <input class="input" readonly value="@_generatedKey" />
            <button type="button" class="btn-secondary" style="flex-shrink:0" @onclick="CopyKey">
                @(_copied ? $"✓ {T.Copied}" : T.Copy)
            </button>
        </div>
        <p class="ss-desc" style="font-weight:600">⚠️ @T.WebhooksKeyOnceHint</p>
    }

    @if (_hasKey)
    {
        <p class="ss-desc">@string.Format(T.WebhooksKeyActiveSince ?? "", _createdAt?.ToLocalTime().ToString("g") ?? "")</p>
        <div class="toggle-row" style="gap:0.75rem;flex-wrap:wrap">
            <button type="button" class="btn-secondary" @onclick="() => _confirmingRegenerate = true" disabled="@_busy">
                @T.WebhooksKeyRegenerateButton
            </button>
            <button type="button" class="btn-danger" @onclick="() => _confirmingRevoke = true" disabled="@_busy">
                @T.WebhooksKeyRevokeButton
            </button>
        </div>
    }
    else
    {
        <button type="button" class="btn-secondary" @onclick="Generate" disabled="@_busy">
            @(_busy ? "…" : T.WebhooksKeyGenerateButton)
        </button>
    }
</div>

@if (_confirmingRegenerate)
{
    <div class="modal-overlay" @onclick="() => _confirmingRegenerate = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.WebhooksKeyRegenerateConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingRegenerate = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.WebhooksKeyRegenerateConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingRegenerate = false" disabled="@_busy">
                    @T.WebhooksKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmRegenerate" disabled="@_busy">
                    @(_busy ? "…" : T.WebhooksKeyRegenerateConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@if (_confirmingRevoke)
{
    <div class="modal-overlay" @onclick="() => _confirmingRevoke = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@T.WebhooksKeyRevokeConfirmTitle</h3>
                <button type="button" class="modal-close" @onclick="() => _confirmingRevoke = false">✕</button>
            </div>
            <div class="modal-body">
                <p>⚠️ @T.WebhooksKeyRevokeConfirmWarning</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="() => _confirmingRevoke = false" disabled="@_busy">
                    @T.WebhooksKeyConfirmCancel
                </button>
                <button type="button" class="btn-danger" @onclick="ConfirmRevoke" disabled="@_busy">
                    @(_busy ? "…" : T.WebhooksKeyRevokeConfirmYes)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private I18nText.SetupText T = new();

    private bool _hasKey;
    private DateTime? _createdAt;
    // Plaintext only visible right after a generation within this page load - the server
    // never gives it out again (only the hash lives in the DB).
    private string? _generatedKey;
    private bool _copied;
    private bool _busy;
    private bool _confirmingRegenerate;
    private bool _confirmingRevoke;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<I18nText.SetupText>(this);
        try
        {
            var status = await Http.GetFromJsonAsync<WebhooksApiKeyStatusDto>("api/settings/webhooks-api-key");
            _hasKey = status?.HasKey ?? false;
            _createdAt = status?.CreatedAt;
        }
        catch { /* offline: card shows the "no key" default */ }
    }

    private async Task Generate()
    {
        _busy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/webhooks-api-key/generate", null);
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<WebhooksApiKeyGenerateResponseDto>();
                if (!string.IsNullOrEmpty(dto?.ApiKey))
                {
                    _generatedKey = dto!.ApiKey;
                    _hasKey = true;
                    _createdAt = dto.CreatedAt;
                }
            }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmRegenerate()
    {
        _confirmingRegenerate = false;
        await Generate();
    }

    private async Task ConfirmRevoke()
    {
        _confirmingRevoke = false;
        _busy = true;
        try
        {
            var response = await Http.PostAsync("api/settings/webhooks-api-key/revoke", null);
            if (response.IsSuccessStatusCode)
            {
                _hasKey = false;
                _createdAt = null;
                _generatedKey = null;
            }
        }
        finally { _busy = false; }
    }

    private async Task CopyKey()
    {
        if (string.IsNullOrEmpty(_generatedKey)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedKey);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }
}

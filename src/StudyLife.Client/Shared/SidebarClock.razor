@using StudyLife.Client.Services
@implements IDisposable
@inject TimeProvider Clock

@* The sidebar clock owns its own 10-second timer so that ticking re-renders ONLY these two
   lines. It used to be driven by MainLayout's timer calling StateHasChanged() on the layout,
   which re-rendered the whole layout including @Body - every dashboard/stats card diffed
   again every ten seconds for a clock nobody was looking at (2026-09 audit L7).
   Because it takes no parameters, Blazor never re-renders it from the layout, so it listens to
   LocalDate.NamesChanged itself: the weekday name (and the 12h/24h clock) follow the UI language
   as soon as the localized names have arrived, instead of staying in the invariant English
   fallback they were first rendered with. *@
<div class="time-display">@LocalDate.Time(_now)</div>
<div class="date-display">@($"{LocalDate.Weekday(_now, true)}, {LocalDate.DayMonth(_now)}")</div>

@code {
    private DateTime _now;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _now = Clock.LocalNow();
        _timer = new System.Threading.Timer(_ => _ = InvokeAsync(Tick), null, 10000, 10000);
        LocalDate.NamesChanged += OnDateNamesChanged;
    }

    private void OnDateNamesChanged() => _ = InvokeAsync(StateHasChanged);

    private void Tick()
    {
        var now = Clock.LocalNow();
        // Only the minute is displayed - skip the render entirely while it hasn't changed.
        if (now.Minute == _now.Minute && now.Day == _now.Day) { _now = now; return; }
        _now = now;
        StateHasChanged();
    }

    public void Dispose()
    {
        LocalDate.NamesChanged -= OnDateNamesChanged;
        _timer?.Dispose();
    }
}

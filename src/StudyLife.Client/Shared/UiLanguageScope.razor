@*
  Hosts the page body under a known UI language. LocalDate/LocalNumber read their language from a
  static that defaults to German, and the layout only learns the real language after its first
  awaits - while the page body was already being rendered. Cards with unchanged parameters never
  re-render, so a native/English start froze "1,66" and "19.05.26" in them. This scope renders
  nothing until the language is known, applies it BEFORE any child renders, and rebuilds the
  subtree (key) when the language changes so already-rendered cards pick up the new formats.
*@
@if (!string.IsNullOrEmpty(Language))
{
    <CascadingValue Value="@Language" IsFixed="true" @key="Language">
        @ChildContent
    </CascadingValue>
}

@code {
    /// <summary>The active UI language code; null or empty while it is still being determined.</summary>
    [Parameter] public string? Language { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Language)) LocalDate.Language = Language;
    }
}

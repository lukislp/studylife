# ============================================================
# StudyLife -- Environment variables
# Copy this file to .env and adjust the values.
# .env is NOT checked into the repository.
# ============================================================

# --- Docker Image (optional) --------------------------------------------
# The default image is the public ghcr.io/lukislp/studylife-server image built by this
# repo's own CI/CD pipeline - no registry login needed to pull it.
# Only set SERVER_IMAGE (and, if it's on a private registry, the REGISTRY_* variables
# below) if you're running your own fork published to your own registry.
# SERVER_IMAGE=registry.example.com/your-fork/studylife-server:latest
# REGISTRY_URL=registry.example.com
# REGISTRY_USER=
# REGISTRY_PASSWORD=

# --- App ----------------------------------------------------
# Port the app is reachable on
PORT=8080

# --- WebAuthn/Passkey (optional) -----------------------------
# Pins the WebAuthn RP-id/origin instead of deriving it from the incoming request's Host
# header. Only needed if you're not using the documented nginx/Gateway setup.
# FIDO2_SERVER_DOMAIN=studylife.example.com
# FIDO2_ORIGINS_0=https://studylife.example.com

# ============================================================
# StudyLife -- Environment variables
# Copy this file to .env and adjust the values.
# .env is NOT checked into the repository.
# ============================================================

# --- Docker Registry --------------------------------------------
# URL of the private registry (without https://)
REGISTRY_URL=registry.example.com

# Registry credentials (prompted for by the setup script,
# but can also be hardcoded here)
REGISTRY_USER=
REGISTRY_PASSWORD=

# --- App ----------------------------------------------------
# Port the app is reachable on
PORT=8080

# --- WebAuthn/Passkey (optional) -----------------------------
# Pins the WebAuthn RP-id/origin instead of deriving it from the incoming request's Host
# header. Only needed if you're not using the documented nginx/Gateway setup.
# FIDO2_SERVER_DOMAIN=studylife.example.com
# FIDO2_ORIGINS_0=https://studylife.example.com
